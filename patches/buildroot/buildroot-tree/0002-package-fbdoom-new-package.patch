diff --git a/package/fbdoom/fbdoom.mk b/package/fbdoom/fbdoom.mk
new file mode 100644
index 0000000000..d9e79ad38f
--- /dev/null
+++ b/package/fbdoom/fbdoom.mk
@@ -0,0 +1,36 @@
+################################################################################
+#
+# fbdoom
+#
+################################################################################
+
+FBDOOM_VERSION = 17280163bc95e5d954d2efaa0633489b763b4cd1
+FBDOOM_SITE = $(call github,maximevince,fbDOOM,$(FBDOOM_VERSION))
+FBDOOM_LICENSE = GPL-2.0
+FBDOOM_LICENSE_FILES = README.TXT
+
+# The Makefile assigns CC with '=', so a command-line CC override is the
+# supported hook: inject Buildroot's target flags there (TARGET_LDFLAGS
+# carries the elf2flt/FLAT link flags on this platform; linker options
+# are inert during the -c compiles). Its internal CFLAGS
+# (-Os -DNORMALUNIX -DLINUX ...) must survive, so CFLAGS itself is not
+# overridden. NOSDL=1 drops the -lSDL default.
+define FBDOOM_BUILD_CMDS
+	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D)/fbdoom \
+		CC="$(TARGET_CC) $(TARGET_CFLAGS) $(TARGET_LDFLAGS)" \
+		CROSS_COMPILE="$(TARGET_CROSS)" \
+		NOSDL=1 fbdoom
+endef
+
+# Doom recurses (R_RenderBSPNode et al.) — the 4 KB elf2flt default is
+# not survivable; 64 KB is the customary uclinux value (+60 KB resident
+# against the ~6 MB Z-zone it mmaps anyway). Set via flthdr rather than
+# FBDOOM_FLAT_STACKSIZE: that variable's -Wl,-elf2flt="-r -s..." value
+# can't survive the nested quoting of the CC override above.
+define FBDOOM_INSTALL_TARGET_CMDS
+	$(INSTALL) -m 0755 -D $(@D)/fbdoom/fbdoom \
+		$(TARGET_DIR)/usr/bin/fbdoom
+	$(TARGET_CROSS)flthdr -s 65536 $(TARGET_DIR)/usr/bin/fbdoom
+endef
+
+$(eval $(generic-package))
