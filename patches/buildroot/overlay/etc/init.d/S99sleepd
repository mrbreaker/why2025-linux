#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# S99sleepd — launch the Fn+Esc display-sleep daemon once.
#
# Deliberately NOT an inittab respawn entry. A respawn line was tried
# first and that boot wedged ~25 s in — but the same boot-window wedge
# was later seen without any respawn entry (docs/KNOWN-ISSUES.md), so
# respawn was never proven guilty. The one-shot launch is still the
# right shape: sleepd never exits by design (all error paths retry
# internally, including waiting for /dev/input/event0 to appear), so
# respawn adds nothing except the *risk* of a hot fork+exec loop — the
# known wedge trigger — if sleepd ever gains a crash bug.

case "$1" in
    start|"")
        /usr/bin/sleepd >/tmp/sleepd.log 2>&1 &
        ;;
    stop)
        killall sleepd 2>/dev/null
        ;;
esac

exit 0
