# /etc/inittab
#
# Copyright (C) 2001 Erik Andersen <andersen@codepoet.org>
#
# Note: BusyBox init doesn't support runlevels.  The runlevels field is
# completely ignored by BusyBox init. If you want runlevels, use
# sysvinit.
#
# Format for each entry: <id>:<runlevels>:<action>:<process>
#
# id        == tty to run on, or empty for /dev/console
# runlevels == ignored
# action    == one of sysinit, respawn, askfirst, wait, and once
# process   == program to run

# Startup the system
::sysinit:/bin/mount -t proc proc /proc
# No remount-rw: the root is a read-only squashfs on mtd-rom; the remount
# fails every boot and burns one 512 KB FLAT fork+exec in the early-boot
# window where deferred probes are still settling.
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
#::sysinit:/sbin/swapon -a
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
# now run any rc scripts
::sysinit:/etc/init.d/rcS

# Put a getty on the serial port
# FB-console getty. Each resident busybox-FLAT process pins ~600 KB
# (measured flthdr footprint 2026-07-05: text+data+bss+16000 stack =
# 613,216 B with vi/inetd/ntpd — the old "under 512 KB" claim went
# stale). The
# patch-0010 pool hands out byte-precise pages, so the ~10 MB pool
# comfortably holds this getty + the UART getty + the wifi-connect
# chain; only the buddy-fallback path transiently needs an order-8
# (1 MB) contiguous block per exec.
#
# TERM=linux, not vt100: /dev/console is tty1 (last console= in
# CONFIG_CMDLINE wins) = fbcon, which implements the "linux" terminal
# type; vt100 terminfo (no colour, wrong function keys) breaks
# terminfo-aware programs like vi on the panel.
console::respawn:/sbin/getty -L console 0 linux # fbcon on tty1

# Stuff to do for the 3-finger salute
#::ctrlaltdel:/sbin/reboot

# Stuff to do before rebooting
::shutdown:/etc/init.d/rcK
#::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r

# WHY2025: serial getty on ttyS0 (in addition to /dev/console = tty1)
ttyS0::respawn:/sbin/getty -L 115200 ttyS0 vt100

# WHY2025: sleepd (Fn+Esc display sleep) is launched once from
# /etc/init.d/S99sleepd, not respawned from here — sleepd never exits
# by design, and a respawn entry could only add a hot fork+exec loop
# (the known wedge trigger, docs/KNOWN-ISSUES.md) if it ever crashed.
