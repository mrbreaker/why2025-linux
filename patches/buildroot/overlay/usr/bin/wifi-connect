#!/bin/sh
# wifi-connect — bring up wlan0 against the on-board ESP32-C6 over esp-hosted-NG.
#
# Usage:   wifi-connect [SSID [PSK]]
#
# NOMMU-aware: binfmt_flat tries the byte-precise patch-0010 userspace
# pool first; only the buddy-heap fallback rounds text+data+bss+stack
# to the next power of two (then trims to exact pages). busybox measures
# ~613 KB all-in (2026-07-05, with vi/inetd/ntpd) so a fallback applet exec
# transiently needs an order-8 (1 MB) contiguous block, and we keep
# wpa_supplicant under 1 MB so it stays order-8 too. Don't let either
# grow past 1 MB: no order-9 (2 MB) block ever exists at boot in the
# 32 MB PSRAM heap and the whole script would fail on the first
# wpa_supplicant exec.
#
# The shell is hush; printf, echo, [, kill, read, case, for, while are
# builtins (zero fork). The script keeps explicit rc checks + buddyinfo
# dumps bracketing each fork point so failures point at the offender.

CONF=/tmp/wpa_supplicant.conf
IFACE=wlan0
PIDFILE=/tmp/wpa_supplicant.$IFACE.pid

SSID="${1:-}"
PSK="${2:-}"

if [ -z "$SSID" ]; then
    printf 'SSID: '
    read -r SSID
fi
if [ -z "$PSK" ]; then
    printf 'Passphrase: '
    stty -echo
    read -r PSK
    stty echo
    printf '\n'
fi

# wpa_supplicant.conf quotes ssid/psk as "..."; a literal " or \ in either
# would break out of the quoting and inject config directives. This tool
# has no fork-free escaping path (hush), so reject them outright.
case "$SSID$PSK" in
    *'"'*|*'\'*)
        printf '[wifi] SSID/PSK must not contain a double-quote or backslash\n' >&2
        exit 1 ;;
esac

dump_buddy() {
    printf '[wifi] %s — buddyinfo / mem free:\n' "$1"
    while read -r line; do
        printf '  %s\n' "$line"
    done < /proc/buddyinfo
    while read -r line; do
        case "$line" in
            MemTotal:*|MemFree:*|MemAvailable:*|Slab:*|Unevictable:*|VmallocUsed:*)
                printf '  %s\n' "$line" ;;
        esac
    done < /proc/meminfo
}

dump_buddy 'pre-conf'

# Build wpa_supplicant.conf via hush printf builtin (zero fork).
umask 077
printf '%s\n' \
    'ctrl_interface=/var/run/wpa_supplicant' \
    'update_config=1' \
    'network={' \
    "    ssid=\"${SSID}\"" \
    "    psk=\"${PSK}\"" \
    '    key_mgmt=WPA-PSK' \
    '}' > "$CONF"
rc=$?
printf '[wifi] wrote %s rc=%d\n' "$CONF" "$rc"
[ "$rc" -eq 0 ] || { printf '[wifi] FAILED writing %s\n' "$CONF"; exit 1; }

dump_buddy 'pre-iplink'
ip link set "$IFACE" up
rc=$?
printf '[wifi] ip link set up rc=%d\n' "$rc"
[ "$rc" -eq 0 ] || { printf '[wifi] FAILED ip link set up\n'; exit 1; }

dump_buddy 'pre-wpa'
# A wpa_supplicant left running by a previous (perhaps failed) call would
# leak a ~1 MB FLAT allocation pinned on the buddy heap. Kill any stale
# instance (pid read via builtin, no fork) before starting a fresh one.
if [ -f "$PIDFILE" ]; then
    read -r oldpid < "$PIDFILE"
    [ -n "$oldpid" ] && kill "$oldpid" 2>/dev/null
    rm -f "$PIDFILE"
fi
wpa_supplicant -B -P "$PIDFILE" -i "$IFACE" -D nl80211 -c "$CONF"
rc=$?
printf '[wifi] wpa_supplicant -B rc=%d\n' "$rc"
[ "$rc" -eq 0 ] || { printf '[wifi] FAILED wpa_supplicant\n'; exit 1; }

# Wait for wpa to finish associating before forking udhcpc. The
# association burst (auth → assoc → 4-way handshake, ~6s on this
# C6 SPI link) allocates skbs from the buddy and fragments any
# remaining 1 MB block, leaving udhcpc with no contiguous region
# to load into. Poll operstate via builtin file read; sleep 1 is
# a transient 1 MB FLAT fork but the page returns to the buddy on
# exit. Wait up to ~16s.
state=dormant
i=0
while [ $i -lt 16 ]; do
    sleep 1
    read -r state < /sys/class/net/"$IFACE"/operstate
    [ "$state" = "up" ] && break
    i=$((i+1))
done
printf '[wifi] operstate after %ds: %s\n' "$i" "$state"

# Don't fork udhcpc if association never completed: kill the still-running
# wpa_supplicant so it doesn't leak, and fail with a clear message instead
# of burning a 30 s udhcpc timeout on a link that will never come up.
if [ "$state" != "up" ]; then
    printf '[wifi] %s never associated (operstate=%s); aborting\n' "$IFACE" "$state" >&2
    if [ -f "$PIDFILE" ]; then
        read -r pid < "$PIDFILE"
        [ -n "$pid" ] && kill "$pid" 2>/dev/null
    fi
    exit 1
fi

dump_buddy 'pre-udhcpc'
printf '[wifi] requesting DHCP lease...\n'
exec udhcpc -i "$IFACE" -n -q -t 30 -A 3
