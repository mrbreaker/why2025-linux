+/* WHY2025 BadgeVMS-style LEDC backlight init.
+ * GPIO 15 = display BL (channel 0, runtime-controllable from the host
+ * via CMD_SET_BACKLIGHT), GPIO 10 = keyboard BL (channel 1, slave-fixed).
+ * The display channel's initial duty matches the host DT's
+ * default-brightness-level so the very first host .apply() doesn't flash.
+ */
+#define BL_PWM_RESOLUTION       LEDC_TIMER_8_BIT          /* 0..255 raw */
+#define BL_PWM_FREQ_HZ          25000                     /* well above audible */
+#define BL_PWM_CLK              LEDC_USE_XTAL_CLK
+#define BL_DISPLAY_GPIO         15
+#define BL_KEYBOARD_GPIO        10
+#define BL_DISPLAY_INITIAL_DUTY 76    /* ~30%; matches DT default-brightness-level */
+#define BL_KEYBOARD_DUTY        25    /* ~10% */
+
+static void why2025_backlight_init(void)
+{
+	ledc_timer_config_t timer_conf = {
+		.speed_mode      = LEDC_LOW_SPEED_MODE,
+		.duty_resolution = BL_PWM_RESOLUTION,
+		.timer_num       = LEDC_TIMER_0,
+		.freq_hz         = BL_PWM_FREQ_HZ,
+		.clk_cfg         = BL_PWM_CLK,
+	};
+	ESP_ERROR_CHECK(ledc_timer_config(&timer_conf));
+
+	const struct { int gpio; ledc_channel_t ch; uint32_t duty; } pins[] = {
+		{ BL_DISPLAY_GPIO,  LEDC_CHANNEL_0, BL_DISPLAY_INITIAL_DUTY },
+		{ BL_KEYBOARD_GPIO, LEDC_CHANNEL_1, BL_KEYBOARD_DUTY        },
+	};
+	for (size_t i = 0; i < sizeof(pins)/sizeof(pins[0]); i++) {
+		ledc_channel_config_t ch_conf = {
+			.gpio_num   = pins[i].gpio,
+			.speed_mode = LEDC_LOW_SPEED_MODE,
+			.channel    = pins[i].ch,
+			.intr_type  = LEDC_INTR_DISABLE,
+			.timer_sel  = LEDC_TIMER_0,
+			.duty       = 0,
+			.hpoint     = 0,
+		};
+		ESP_ERROR_CHECK(ledc_channel_config(&ch_conf));
+		ESP_ERROR_CHECK(ledc_set_duty(LEDC_LOW_SPEED_MODE, pins[i].ch, pins[i].duty));
+		ESP_ERROR_CHECK(ledc_update_duty(LEDC_LOW_SPEED_MODE, pins[i].ch));
+	}
+}
+
 static const char TAG[] = "FW_MAIN";
 
