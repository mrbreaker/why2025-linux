+/*
+ * Anomaly repair. A dispatch that finds mcause.mpil != 0 is the wedge
+ * fingerprint (docs/RUNTIME-WEDGE.md): Linux never nests interrupts on
+ * this port, so the interrupted context can only legitimately be at
+ * level 0. Both captured wedges show exactly one such record -- a timer
+ * interrupt that raced the previous mret and saw the pre-mret level
+ * (0xFF) -- as the LAST interrupt ever delivered; whatever internal
+ * level/gateway state the race latches then blocks all delivery once
+ * this handler returns. We are therefore running exactly one mret
+ * before the badge dies: poke the CLIC back to a sane state while code
+ * still executes. The pulses below are speculative unstick attempts
+ * (the stuck state is not architecturally visible); the tracer's
+ * post-reboot dump plus "did the repro stop wedging" is the verdict.
+ */
+static void wt_try_repair(u32 mcause)
+{
+	u32 quad, i;
+
+	wt_hdr->anomalies++;
+	wt_hdr->last_anom_thresh = readl(wt_clic_ctrl + CLIC_INT_THRESH_OFF);
+	wt_hdr->last_anom_c17 = readl(wt_clic_slots + CLIC_SLOT_SYSTIMER * 4);
+
+	/* 1. Pulse the run-time threshold to max and back: forces the
+	 *    CLIC's level comparator through a full transition. */
+	writel(0xFF000000, wt_clic_ctrl + CLIC_INT_THRESH_OFF);
+	mb();
+	writel(wt_hdr->last_anom_thresh, wt_clic_ctrl + CLIC_INT_THRESH_OFF);
+	mb();
+
+	/* 2. Toggle INTIE on the active external slots (16..23): kicks the
+	 *    per-slot gateway state machines. */
+	for (i = 16; i <= 23; i++) {
+		quad = readl(wt_clic_slots + i * 4);
+		if (!(quad & 0x100))	/* INTIE clear -- slot unused */
+			continue;
+		writel(quad & ~0x100, wt_clic_slots + i * 4);
+		mb();
+		writel(quad, wt_clic_slots + i * 4);
+		mb();
+	}
+
+	pr_alert("mpil anomaly #%u (cause=%08x) -- repair attempted\n",
+		 wt_hdr->anomalies, mcause);
+	wt_writeback(wt_hdr, sizeof(*wt_hdr));
 }
 
