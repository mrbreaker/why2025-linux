+++ b/arch/riscv/include/asm/cacheflush.h	2026-05-05 11:14:25.077147108 +0200
@@ -10,12 +10,42 @@
 
 static inline void local_flush_icache_all(void)
 {
+#ifdef CONFIG_SOC_ESP32P4
+	/*
+	 * ESP32-P4 HP core: fence.i does not flush the external-memory
+	 * cache hierarchy (L1 I$/D$/L2). Use the ROM helpers at fixed
+	 * addresses to writeback all of D$/L2 and invalidate all of
+	 * I$/L2. Required for self-modifying code / loaded binaries in
+	 * PSRAM (binfmt_flat, kernel modules, eBPF, ...).
+	 *
+	 *   Cache_WriteBack_All(map)   @ 0x4fc00414
+	 *   Cache_Invalidate_All(map)  @ 0x4fc00404
+	 *   L1 DCACHE=BIT(4)=0x10, L1 ICACHE_MASK=0x3, L2=BIT(5)=0x20
+	 */
+	void (*wb_all)(uint32_t)  = (void (*)(uint32_t))0x4fc00414UL;
+	void (*inv_all)(uint32_t) = (void (*)(uint32_t))0x4fc00404UL;
+	wb_all(0x10);   /* L1 DCACHE writeback */
+	wb_all(0x20);   /* L2 writeback */
+	inv_all(0x03);  /* L1 ICACHE (both halves) invalidate */
+	inv_all(0x20);  /* L2 invalidate */
+#endif
 	asm volatile ("fence.i" ::: "memory");
 }
 
 static inline void local_flush_icache_range(unsigned long start,
 					    unsigned long end)
 {
+#ifdef CONFIG_SOC_ESP32P4
+	void (*wb_addr)(uint32_t, uint32_t, uint32_t)  =
+		(void (*)(uint32_t, uint32_t, uint32_t))0x4fc003f4UL;
+	void (*inv_addr)(uint32_t, uint32_t, uint32_t) =
+		(void (*)(uint32_t, uint32_t, uint32_t))0x4fc003e4UL;
+	uint32_t size = (uint32_t)(end - start);
+	wb_addr(0x10, (uint32_t)start, size);   /* L1 D writeback */
+	wb_addr(0x20, (uint32_t)start, size);   /* L2 writeback */
+	inv_addr(0x03, (uint32_t)start, size);  /* L1 I invalidate */
+	inv_addr(0x20, (uint32_t)start, size);  /* L2 invalidate */
+#endif
 	local_flush_icache_all();
 }
 
