+#ifdef CONFIG_SOC_ESP32P4
+/*
+ * ESP32-P4 HP core implements only M-mode, so userspace also runs in
+ * M-mode and mstatus.MPP is always M.  The generic "SR_PP == 0 means
+ * user" test is therefore useless on this platform.
+ *
+ * Instead, exploit entry.S's CSR_SCRATCH invariant:
+ *   SCRATCH == 0          while the kernel runs
+ *   SCRATCH == kernel-tp  while a user task runs
+ * At trap entry handle_exception swaps tp <-> SCRATCH and then saves
+ * the pre-swap SCRATCH value into pt_regs->tp.  So:
+ *   user  trap:  pt_regs->tp = user_tp     (!= current kernel tp)
+ *   kernel trap: pt_regs->tp = kernel_tp   (== current kernel tp)
+ * Compare regs->tp against the currently-running tp to decide.  This
+ * is reliable as long as the comparison is done before any context
+ * switch (true for every user_mode() call site in arch/riscv: they
+ * all run in the trap/syscall handler before scheduling).
+ */
+static __always_inline bool __esp32p4_user_mode(struct pt_regs *regs)
+{
+	unsigned long cur_tp;
+	__asm__ __volatile__("mv %0, tp" : "=r"(cur_tp));
+	return regs->tp != cur_tp;
+}
+#define user_mode(regs) __esp32p4_user_mode(regs)
+#else
