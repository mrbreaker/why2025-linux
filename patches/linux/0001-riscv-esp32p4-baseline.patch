--- /dev/null	2026-05-03 14:38:22.219445125 +0200
+++ b/drivers/clocksource/timer-esp32p4-systimer.c	2026-05-05 11:14:25.077864193 +0200
@@ -0,0 +1,226 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ESP32-P4 SYSTIMER clocksource and clockevent driver
+ *
+ * The SYSTIMER is a 52-bit counter running at 16 MHz (XTAL).  It requires
+ * an explicit latch-then-read sequence to capture a consistent value.
+ *
+ * SYSTIMER alarm 0 is used for the clockevent.  The interrupt is routed
+ * through the ESP32-P4 interrupt matrix to CLIC slot 17 (first external
+ * peripheral slot), dispatched by the ESP32-P4 CLIC irqchip driver.
+ * INTMTX routing is handled by the CLIC irqchip driver via the 2-cell
+ * interrupt specifier in the DTS.
+ */
+
+#define pr_fmt(fmt) "esp32p4-systimer: " fmt
+
+#include <linux/clockchips.h>
+#include <linux/clocksource.h>
+#include <linux/interrupt.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/sched_clock.h>
+#include <asm/delay.h>		/* riscv_timebase */
+
+/* SYSTIMER register byte offsets (struct size = 0x100) */
+#define ST_CONF          0x00   /* clk_en[31], unit0_work_en[30], target0_work_en[24] */
+#define ST_UNIT0_OP      0x04   /* update[30] (WT), valid[29] (RO) */
+#define ST_TARGET0_HI    0x1C   /* target high 20 bits */
+#define ST_TARGET0_LO    0x20   /* target low 32 bits */
+#define ST_TARGET0_CONF  0x34   /* period_mode[30]=0 (oneshot), unit_sel[31]=0 (unit0) */
+#define ST_UNIT0_VAL_HI  0x40   /* latched counter high 20 bits */
+#define ST_UNIT0_VAL_LO  0x44   /* latched counter low 32 bits */
+#define ST_COMP0_LOAD    0x50   /* write 1 to apply target_val[0] to comparator */
+#define ST_INT_ENA       0x64   /* target0_int_ena[0] */
+#define ST_INT_CLR       0x6C   /* target0_int_clr[0] (WT) */
+#define ST_INT_ST        0x70   /* target0_int_st[0] (RO) */
+
+#define ST_CONF_CLK_EN         BIT(31)
+#define ST_CONF_UNIT0_WORK_EN  BIT(30)
+#define ST_CONF_TARGET0_EN     BIT(24)
+#define ST_UNIT0_OP_UPDATE     BIT(30)
+#define ST_UNIT0_OP_VALID      BIT(29)
+
+/* CLIC slot 17 is used for SYSTIMER (first external peripheral slot). */
+#define CLIC_SLOT_SYSTIMER  17
+
+/*
+ * CLIC slot 17 is edge-triggered (DTS: IRQ_TYPE_EDGE_RISING). The flow
+ * handler we install (handle_percpu_devid_irq) does not ack the CLIC,
+ * so INTIP latches on each rising edge and we must clear it from this
+ * ISR. Without this, the second alarm sees INTIP already pending and
+ * no new edge is delivered — scheduler tick dies after the first fire.
+ *
+ * CLIC base and INTIP offset come from the irqchip driver.
+ */
+#define CLIC_BASE        0x20801000
+#define CLIC_INTIP_OFF   0
+
+static void __iomem *st_base;
+static unsigned int esp32p4_timer_irq;
+static void __iomem *clic_slot17_intip;
+
+/* ------------------------------------------------------------------ */
+/*  Counter read (52-bit, 16 MHz)                                      */
+/* ------------------------------------------------------------------ */
+
+static u64 notrace esp32p4_systimer_read64(void)
+{
+	u32 hi, lo;
+
+	/* Trigger latch of unit 0 counter */
+	writel(ST_UNIT0_OP_UPDATE, st_base + ST_UNIT0_OP);
+	/* Wait for the captured value to be valid (typically 2-3 cycles) */
+	while (!(readl(st_base + ST_UNIT0_OP) & ST_UNIT0_OP_VALID))
+		;
+	hi = readl(st_base + ST_UNIT0_VAL_HI) & 0xFFFFF;
+	lo = readl(st_base + ST_UNIT0_VAL_LO);
+
+	return ((u64)hi << 32) | lo;
+}
+
+static u64 esp32p4_cs_read(struct clocksource *cs)
+{
+	return esp32p4_systimer_read64();
+}
+
+static struct clocksource esp32p4_clocksource = {
+	.name   = "esp32p4-systimer",
+	.rating = 300,
+	.read   = esp32p4_cs_read,
+	.mask   = CLOCKSOURCE_MASK(52),
+	.flags  = CLOCK_SOURCE_IS_CONTINUOUS,
+};
+
+/* ------------------------------------------------------------------ */
+/*  Clockevent (oneshot via alarm 0)                                   */
+/* ------------------------------------------------------------------ */
+
+static DEFINE_PER_CPU(struct clock_event_device, esp32p4_clock_event) = {
+	.name     = "esp32p4-systimer",
+	.features = CLOCK_EVT_FEAT_ONESHOT,
+	.rating   = 300,
+};
+
+static int esp32p4_clkevt_set_next(unsigned long delta,
+				    struct clock_event_device *ce)
+{
+	u64 target;
+	u32 conf;
+
+	/* Disable alarm while reprogramming */
+	conf = readl(st_base + ST_CONF);
+	writel(conf & ~ST_CONF_TARGET0_EN, st_base + ST_CONF);
+
+	target = esp32p4_systimer_read64() + delta;
+	writel((u32)(target >> 32) & 0xFFFFF, st_base + ST_TARGET0_HI);
+	writel((u32)target,                    st_base + ST_TARGET0_LO);
+
+	/* Oneshot mode, unit 0 — clear period_mode and unit_sel */
+	writel(0, st_base + ST_TARGET0_CONF);
+
+	/* Sync target value into hardware comparator */
+	writel(1, st_base + ST_COMP0_LOAD);
+
+	/* Enable target-0 interrupt and re-arm alarm */
+	writel(readl(st_base + ST_INT_ENA) | BIT(0), st_base + ST_INT_ENA);
+	writel(readl(st_base + ST_CONF) | ST_CONF_TARGET0_EN, st_base + ST_CONF);
+
+	return 0;
+}
+
+static irqreturn_t esp32p4_timer_interrupt(int irq, void *dev_id)
+{
+	struct clock_event_device *ce = this_cpu_ptr(&esp32p4_clock_event);
+
+	/* Disable alarm and clear pending interrupt at the SYSTIMER */
+	writel(readl(st_base + ST_CONF) & ~ST_CONF_TARGET0_EN, st_base + ST_CONF);
+	writel(BIT(0), st_base + ST_INT_CLR);
+
+	/*
+	 * Clear CLIC slot 17 pending bit. handle_percpu_devid_irq does not
+	 * call irq_ack, so without this the edge-triggered slot stays latched
+	 * and no further rising edges are seen after the first fire.
+	 */
+	if (clic_slot17_intip)
+		writeb(0, clic_slot17_intip);
+
+	ce->event_handler(ce);
+	return IRQ_HANDLED;
+}
+
+/* ------------------------------------------------------------------ */
+/*  Initialisation                                                      */
+/* ------------------------------------------------------------------ */
+
+static int __init esp32p4_systimer_init(struct device_node *np)
+{
+	struct clock_event_device *ce;
+	int ret;
+
+	st_base = of_iomap(np, 0);
+	if (!st_base) {
+		pr_err("failed to map SYSTIMER registers\n");
+		return -ENOMEM;
+	}
+
+	/* Map CLIC slot 17 INTIP byte for direct ack from our ISR. */
+	clic_slot17_intip = ioremap(CLIC_BASE + CLIC_SLOT_SYSTIMER * 4 +
+				    CLIC_INTIP_OFF, 1);
+	if (!clic_slot17_intip)
+		pr_warn("could not map CLIC INTIP for slot %d; tick may stall\n",
+			CLIC_SLOT_SYSTIMER);
+
+	/* Enable SYSTIMER register file clock and counter unit 0 */
+	writel(readl(st_base + ST_CONF) | ST_CONF_CLK_EN | ST_CONF_UNIT0_WORK_EN,
+	       st_base + ST_CONF);
+
+	/* Clear any stale alarm-0 interrupt */
+	writel(BIT(0), st_base + ST_INT_CLR);
+	writel(readl(st_base + ST_INT_ENA) & ~BIT(0), st_base + ST_INT_ENA);
+
+	/* clocksource */
+	ret = clocksource_register_hz(&esp32p4_clocksource, riscv_timebase);
+	if (ret) {
+		pr_err("clocksource register failed (%d)\n", ret);
+		return ret;
+	}
+	sched_clock_register(esp32p4_systimer_read64, 52, riscv_timebase);
+
+	/* clockevent — single core, configure directly for CPU 0 */
+	esp32p4_timer_irq = irq_of_parse_and_map(np, 0);
+	if (!esp32p4_timer_irq) {
+		pr_err("failed to map timer IRQ\n");
+		return -ENODEV;
+	}
+
+	/*
+	 * The CLIC domain map uses handle_edge_irq (non-percpu) by default.
+	 * Promote this IRQ to percpu so the clock event subsystem can use
+	 * request_percpu_irq / enable_percpu_irq on an SMP-capable kernel.
+	 */
+	irq_set_percpu_devid(esp32p4_timer_irq);
+	irq_set_chip_and_handler(esp32p4_timer_irq,
+				 irq_get_chip(esp32p4_timer_irq),
+				 handle_percpu_devid_irq);
+
+	ret = request_percpu_irq(esp32p4_timer_irq, esp32p4_timer_interrupt,
+				  "esp32p4-systimer", &esp32p4_clock_event);
+	if (ret) {
+		pr_err("request_percpu_irq failed (%d)\n", ret);
+		return ret;
+	}
+
+	ce = this_cpu_ptr(&esp32p4_clock_event);
+	ce->cpumask = cpumask_of(0);
+	ce->set_next_event = esp32p4_clkevt_set_next;
+	clockevents_config_and_register(ce, riscv_timebase, 100, ULONG_MAX);
+	enable_percpu_irq(esp32p4_timer_irq, IRQ_TYPE_NONE);
+
+	pr_info("SYSTIMER @ %lu Hz, IRQ %u (CLIC slot %d)\n",
+		riscv_timebase, esp32p4_timer_irq, CLIC_SLOT_SYSTIMER);
+	return 0;
+}
+
+TIMER_OF_DECLARE(esp32p4_systimer, "espressif,esp32p4-systimer",
+		 esp32p4_systimer_init);
