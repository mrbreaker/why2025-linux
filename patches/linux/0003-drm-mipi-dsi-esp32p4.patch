+/* ---------- display pipe -------------------------------------------------- */
+
+static const uint32_t esp32p4_dsi_formats[] = {
+	DRM_FORMAT_RGB565,
+};
+
+/*
+ * DRM bridge enable sequence for this driver:
+ *
+ *   pipe_enable  (CRTC loop, fires first)
+ *     └─ caches DPI timing from drm_display_mode; schedules dpi_enable_work
+ *        400 ms out.  No bridge registers are written here because pipe_enable
+ *        runs before the bridge chain — asserting DSI_BRG_EN at this point
+ *        would drive DPI sync onto the DW host's DPI input while it is still
+ *        in command mode for panel DCS init, which can upset LP escape timing.
+ *
+ *   bridge_atomic_pre_enable  (fires next, reverse order)
+ *     ├─ panel_bridge pre_enable → drm_panel_prepare(): GPIO reset + full
+ *     │  DCS init sequence (st7703: sleep-out + init table, ~150 ms total)
+ *     └─ DW bridge pre_enable   → phy_init (PLL bytes via test i/f),
+ *        set_mode(CMD), phy_power_on (clock lane → LP-Stop)
+ *
+ *   bridge_atomic_enable  (fires next, forward order)
+ *     ├─ DW bridge enable  → set_mode(VIDEO): TXREQUESTCLKHS=1, clock lane
+ *     │  enters HS.  DW host now waits for DPI VSYNC to start a frame.
+ *     └─ panel_bridge enable → drm_panel_enable(): DCS display-on
+ *
+ *   dpi_enable_work  (400 ms after pipe_enable, well after panel DCS done)
+ *     ├─ program all Espressif bridge registers (timing, pixel type, DMA cfg)
+ *     ├─ DSI_BRG_EN=1: bridge starts driving DPI sync → DW host starts HS
+ *     │  video packets.  C6 detects HS traffic → backlight turns on.
+ *     ├─ MODE_CFG=0 (video): belt-and-braces restore in case DCS reads
+ *     │  parked the host in CMD mode.
+ *     └─ DPI_EN=1: pixel data output begins (fill colour until DMA wired).
+ */
+/*
+ * Deferred late-enable work — v5.
+ *
+ * Fires ~2 s after pipe_enable, well after the bridge chain's
+ * panel_bridge.enable callback has finished issuing all panel DCS init
+ * (ST7703 .enable does init sequence + ~120 ms sleep_out + DISPLAY_ON).
+ *
+ * At this point MODE_CFG is still 1 (CMD) because the DW core honored
+ * plat_data->defer_video_mode_switch and skipped set_mode(VIDEO) in
+ * atomic_enable. Bridge is still OFF (we removed the bridge-enable block
+ * from phy_power_on).
+ *
+ * The work now does what IDF does in dpi_panel_init(): program bridge
+ * timing, enable DSI_BRG_EN, enable DPI output, then call
+ * dw_mipi_dsi_late_enable_video() to hand the host over to VIDEO mode.
+ *
+ * TODO after bring-up: replace the fixed 2 s delay with a proper hook
+ * triggered by the bridge chain enable completion, or move the late-
+ * enable into a custom bridge wrapper.
+ */
+/* ---------- DW-GDMA wiring (GDMA wiring) -------------------------- */
+
+/*
+ * Fill a 720x720 RGB565 framebuffer with vertical colour bars.
+ * Order from left to right: red, green, blue, white.
+ *
+ * RGB565 packing: bits[15:11]=R5, bits[10:5]=G6, bits[4:0]=B5.
+ * Stored little-endian in memory.
+ */
+static void esp32p4_dsi_fill_test_pattern(u16 *fb, u32 hdisp, u32 vdisp)
+{
+	/*
+	 * DIAGNOSTIC: solid white. If the panel goes from black to white,
+	 * the entire pipeline (PSRAM→GDMA→bridge→host→PHY→panel) is
+	 * delivering pixels and the issue is something about our colour bar
+	 * fill pattern. If the panel stays black with all-white fill, pixels
+	 * aren't landing at all — DMA is delivering zeros (cache flush
+	 * issue) or panel is rejecting every packet.
+	 *
+	 * RGB565 0xFFFF = R31 G63 B31 = white.
+	 */
+	u32 i, total = hdisp * vdisp;
+
+	for (i = 0; i < total; i++)
+		fb[i] = 0xFFFF;
+}
+
+/*
+ * One-shot DW-GDMA setup:
+ *   - Allocate a static framebuffer in coherent memory
+ *   - Fill with test pattern
+ *   - Allocate one LLI, point its 'next' field at itself (loop forever)
+ *   - Configure GDMA channel 0: mem→DSI bridge, DMA-as-flow-controller,
+ *     hardware handshake, DSI periph (id=0)
+ *   - Enable the channel via CHEN0
+ *
+ * Idempotent: safe to call multiple times; only does work on first call.
+ *
+ * After this returns, GDMA is continuously pumping pixels into the bridge
+ * FIFO at 0x50105000. The bridge then generates DPI sync + pixclk for the
+ * DW host, which packetises and emits HS video on the data lanes.
+ */
+static int esp32p4_dsi_gdma_arm(struct esp32p4_dsi *dsi)
+{
+	struct device *dev = dsi->dev;
+	void __iomem *g = dsi->gdma_regs;
+	const u32 hdisp = dsi->hdisp_cache;
+	const u32 vdisp = dsi->vdisp_cache;
+	const size_t fb_size = (size_t)hdisp * vdisp * 2; /* RGB565 = 2 B/px */
+	const u32 chan = 0;
+	const u32 ch = GDMA_CH_OFFSET(chan);
+	struct esp32p4_gdma_lli *lli;
+	u32 cfg0_val, cfg1_val, ctl0_val, ctl1_val;
+
+	if (dsi->gdma_armed)
+		return 0;
+
+	/*
+	 * Bring the DW-GDMA controller out of any stale state from prior
+	 * boots. dw_gdma_ll_reset(): write 1 to dmac_rst, wait for hw to
+	 * clear it. Then enable the top-level DMAC + interrupt master. This
+	 * MUST happen before any per-channel writes — channel registers
+	 * don't take effect with dmac_en=0.
+	 */
+	writel(BIT(0), g + GDMA_RESET0);	/* dmac_rst = 1 */
+	{
+		int wait = 1000;
+
+		while ((readl(g + GDMA_RESET0) & BIT(0)) && --wait)
+			udelay(1);
+		if (!wait)
+			dev_warn(dev, "GDMA reset did not self-clear\n");
+	}
+	writel(BIT(0) | BIT(1), g + GDMA_CFG0);	/* dmac_en | int_en */
+
+	/* Framebuffer — coherent allocation. On NOMMU RV32 this returns a
+	 * directly-mapped buffer; phys == virt and we can stamp pixels into
+	 * it then hand the same address to the DMA engine. */
+	dsi->fb_cpu = dma_alloc_coherent(dev, fb_size, &dsi->fb_dma, GFP_KERNEL);
+	if (!dsi->fb_cpu)
+		return dev_err_probe(dev, -ENOMEM, "fb alloc (%zu bytes) failed\n", fb_size);
+	dsi->fb_size = fb_size;
+
+	esp32p4_dsi_fill_test_pattern(dsi->fb_cpu, hdisp, vdisp);
+	/* Push pixels from D-cache out to PSRAM so DMA sees them. */
+	esp32p4_dsi_psram_flush(dsi->fb_cpu, fb_size);
+
+	/* LLI — 64 bytes, 64-byte aligned. dma_alloc_coherent bumps to PAGE
+	 * boundary (≥64 B), so the alignment requirement is met for free. */
+	dsi->lli_cpu = dma_alloc_coherent(dev, sizeof(*dsi->lli_cpu),
+					  &dsi->lli_dma, GFP_KERNEL);
+	if (!dsi->lli_cpu) {
+		dma_free_coherent(dev, fb_size, dsi->fb_cpu, dsi->fb_dma);
+		dsi->fb_cpu = NULL;
+		return dev_err_probe(dev, -ENOMEM, "lli alloc failed\n");
+	}
+	lli = dsi->lli_cpu;
+	memset(lli, 0, sizeof(*lli));
+
+	/* Build the LLI. Block transfer size is in 64-bit words: total bits
+	 * = fb_size * 8, divided by 64. Hardware wants N-1 in the field. */
+	lli->sar0 = (u32)dsi->fb_dma;
+	lli->dar0 = ESP32P4_DSI_BRG_MEM_BASE;
+	lli->block_ts0 = ((fb_size * 8 / 64) - 1) & 0x3FFFFFu;
+	/* llp0: lms (master port for the LLP fetch itself) in bit 0.
+	 *   lms = 1 = MEMORY  (correct for fetching LLI from PSRAM)
+	 *   lms = 0 = MIPI_DSI (wrong — would fetch from bridge FIFO)
+	 * IDF constants: DW_GDMA_LL_MASTER_PORT_MIPI_DSI=0, _MEMORY=1.
+	 * loc0 in bits[31:6] = next LLI addr >> 6. Self-loop: point at us. */
+	lli->llp0 = (((u32)dsi->lli_dma) & ~0x3Fu) | BIT(0);	/* lms=1 (MEMORY) */
+	lli->llp1 = 0;
+	/* CTL0: src=mem (sms=1, sinc=INCR), dst=DSI bridge (dms=0, dinc=FIXED),
+	 * 64-bit transfer width, msize 512 (src) / 256 (dst) — matches IDF. */
+	ctl0_val = GDMA_CTL0_SMS_MEMORY | GDMA_CTL0_DMS_DSI |
+		   GDMA_CTL0_SINC_INCR | GDMA_CTL0_DINC_FIXED |
+		   GDMA_CTL0_SRC_TR_WIDTH(GDMA_CTL0_TR_WIDTH_64) |
+		   GDMA_CTL0_DST_TR_WIDTH(GDMA_CTL0_TR_WIDTH_64) |
+		   GDMA_CTL0_SRC_MSIZE(GDMA_CTL0_MSIZE_512) |
+		   GDMA_CTL0_DST_MSIZE(GDMA_CTL0_MSIZE_256);
+	lli->ctl0 = ctl0_val;
+	/* CTL1: AXI burst length 16 on both sides; LLI is valid + NOT last
+	 * (NOT last → engine fetches next, which is self → loops forever). */
+	ctl1_val = GDMA_CTL1_ARLEN_EN | GDMA_CTL1_ARLEN(16) |
+		   GDMA_CTL1_AWLEN_EN | GDMA_CTL1_AWLEN(16) |
+		   GDMA_CTL1_LLI_VALID;	/* lli_last left at 0 */
+	lli->ctl1 = ctl1_val;
+
+	/* Configure channel registers (cfg0 / cfg1 / llp / block_ts).
+	 *
+	 * In LIST multi-block mode, sar/dar/block_ts are pulled from the LLI
+	 * by hardware on transfer start; we still set the channel's llp to
+	 * point at the LLI head. cfg0 selects multi-block type, cfg1 selects
+	 * transfer flow + handshake.
+	 */
+	cfg0_val = GDMA_CFG0_SRC_MULTIBLK_LIST | GDMA_CFG0_DST_MULTIBLK_LIST;
+	writel(cfg0_val, g + ch + GDMA_CH_CFG0);
+
+	cfg1_val = GDMA_CFG1_TT_FC_M2P_DMAC |	/* mem→periph, DMAC is FC */
+		   GDMA_CFG1_HS_SEL_SRC_HW |
+		   GDMA_CFG1_HS_SEL_DST_HW |
+		   GDMA_CFG1_DST_PER_DSI |	/* DSI handshake periph (id=0) */
+		   GDMA_CFG1_CH_PRIOR(1) |
+		   GDMA_CFG1_SRC_OSR_LMT(5) |	/* 5 outstanding reads from PSRAM */
+		   GDMA_CFG1_DST_OSR_LMT(2);	/* 2 outstanding writes to bridge */
+	writel(cfg1_val, g + ch + GDMA_CH_CFG1);
+
+	/* Channel's LLP register: lms (bit 0) = 1 = MEMORY (so engine fetches
+	 * the first LLI from PSRAM, not from the DSI bridge port). loc0 in
+	 * bits[31:6] = LLI addr >> 6 (low 6 bits ignored). */
+	writel((((u32)dsi->lli_dma) & ~0x3Fu) | BIT(0), g + ch + GDMA_CH_LLP0);
+	writel(0, g + ch + GDMA_CH_LLP1);
+
+	/* Disable channel-level interrupts for now — we don't have an IRQ
+	 * handler, and the channel runs autonomously. */
+	writel(0, g + ch + GDMA_CH_INTSIGENA0);
+	writel(0, g + ch + GDMA_CH_INTSIGENA1);
+
+	/* Flush LLI fields out of D-cache so the GDMA engine reads what we
+	 * just wrote (PSRAM, not stale zeros). MUST happen before channel
+	 * enable, else engine fetches lli_valid=0 and fires
+	 * SHADOWREG_OR_LLI_INVALID_ERR (INT_ST0 bit 13). */
+	esp32p4_dsi_psram_flush(lli, sizeof(*lli));
+
+	/* Finally, enable channel via CHEN0 write-enable mask. */
+	writel(GDMA_CHEN_ENABLE(chan), g + GDMA_CHEN0);
+
+	dev_info(dev,
+		 "GDMA armed: fb @%pad (%zu B) -> %#x via LLI @%pad chan=%u; "
+		 "block_ts=%u (64b words)\n",
+		 &dsi->fb_dma, fb_size, ESP32P4_DSI_BRG_MEM_BASE,
+		 &dsi->lli_dma, chan, lli->block_ts0 + 1);
+
+	/*
+	 * Wait for the GDMA engine to fetch the LLI and start filling the
+	 * bridge FIFO. Without this delay the host transitions into VIDEO
+	 * mode (in late_enable_video, called by our caller) with an empty
+	 * bridge FIFO and locks the system bus — boot freezes.
+	 */
+	udelay(1000);
+
+	dsi->gdma_armed = true;
+	return 0;
+}
+
+static void esp32p4_dsi_gdma_release(struct esp32p4_dsi *dsi)
+{
+	if (!dsi->gdma_armed)
+		return;
+	/* Disable channel: write 0 to ch_en bit, 1 to ch_en_we mask. */
+	writel((1u << (8 + 0)), dsi->gdma_regs + GDMA_CHEN0);
+	if (dsi->lli_cpu) {
+		dma_free_coherent(dsi->dev, sizeof(*dsi->lli_cpu),
+				  dsi->lli_cpu, dsi->lli_dma);
+		dsi->lli_cpu = NULL;
+	}
+	if (dsi->fb_cpu) {
+		dma_free_coherent(dsi->dev, dsi->fb_size,
+				  dsi->fb_cpu, dsi->fb_dma);
+		dsi->fb_cpu = NULL;
+	}
+	dsi->gdma_armed = false;
+}
+
+/* Forward decl: defined alongside pipe_update below. */
+static bool esp32p4_dsi_blit_fb(struct esp32p4_dsi *dsi,
+				struct drm_framebuffer *fb,
+				u32 src_y);
+
+static void esp32p4_dsi_fbdev_setup_work(struct work_struct *work)
+{
