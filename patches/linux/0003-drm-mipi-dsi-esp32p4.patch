--- /dev/null	2026-05-03 14:38:22.219445125 +0200
+++ b/drivers/gpu/drm/espressif/dw-mipi-dsi-esp32p4.c	2026-05-05 11:14:25.131337357 +0200
@@ -0,0 +1,1800 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Espressif ESP32-P4 MIPI-DSI glue driver —
+ *
+ * Wraps the Synopsys DW-MIPI-DSI host IP with the Espressif bridge glue.
+ *
+ * Gate 5c (current): full DRM modeset path. Registers a drm_device, a
+ * drm_simple_display_pipe (one plane, one CRTC, one encoder), and attaches
+ * the DW-MIPI-DSI bridge. pipe_enable programs the Espressif DPI bridge and
+ * enables DPI output 400 ms after the panel DCS init completes. Expected
+ * result: C6 detects HS traffic → backlight on → underrun fill colour on
+ * screen (DW-GDMA not yet wired; comes in the next gate).
+ *
+ * Still unimplemented (next gate):
+ *   - DW-GDMA descriptor chain feeding CMA framebuffer → real pixels.
+ *   - Element-order mux (Finding #3; RGB vs BGR byte swap).
+ *   - Proper esp32p4-clk / esp32p4-ldo DT driver replacements for the
+ *     direct register pokes in clkrst_audit() and ldo3_enable().
+ *
+ * Target path in-tree: drivers/gpu/drm/espressif/dw-mipi-dsi-esp32p4.c.
+ *
+ * Reference: drivers/gpu/drm/stm/dw_mipi_dsi-stm.c.
+ */
+
+#include <linux/component.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/ratelimit.h>
+#include <linux/regulator/consumer.h>
+#include <linux/reset.h>
+
+#include <drm/bridge/dw_mipi_dsi.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_bridge.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_fb_helper.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_print.h>
+#include <drm/drm_fbdev_dma.h>
+#include <drm/clients/drm_client_setup.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+
+/*
+ * HP_SYS_CLKRST registers that gate the MIPI-DSI subsystem. Taken from
+ * esp-idf/components/soc/esp32p4/register/hw_ver1/soc/hp_sys_clkrst_reg.h:
+ *
+ *   DR_REG_HP_SYS_CLKRST_BASE = DR_REG_HPPERIPH1_BASE (0x500C0000) + 0x26000
+ *                              = 0x500E6000
+ *   SOC_CLK_CTRL1        @ +0x18   bit 12: REG_DSI_SYS_CLK_EN
+ *   PERI_CLK_CTRL02      @ +0x38   PHY cfg-clock source select (not used here)
+ *   PERI_CLK_CTRL03      @ +0x3C   bit 0: DSI_DPHY_CFG_CLK_EN
+ *                                  bit 1: DSI_DPHY_PLL_REFCLK_EN
+ *   HP_RST_EN0           @ +0xC0   bit 26: RST_EN_DSI_BRG (pulse 1→0)
+ *
+ * On a real upstream port this belongs in a P4 clock-controller driver
+ * exposing clk/reset handles via DT; for now we poke the bits directly so
+ * we can answer "is the DSI peripheral even clocked?" without waiting on
+ * that driver.
+ */
+#define ESP32P4_HP_SYS_CLKRST_BASE	0x500E6000
+#define ESP32P4_HP_SYS_CLKRST_SIZE	0x1000
+
+#define HP_SYS_CLKRST_SOC_CLK_CTRL0	0x14
+#define  GDMA_CPU_CLK_EN		BIT(13)	/* DW-GDMA CPU/AHB clock */
+#define HP_SYS_CLKRST_SOC_CLK_CTRL1	0x18
+#define  GDMA_SYS_CLK_EN		BIT(5)	/* DW-GDMA sys clock */
+#define  DMA2D_SYS_CLK_EN		BIT(6)	/* 2D DMA sys clock */
+#define  DSI_SYS_CLK_EN			BIT(12)
+#define HP_SYS_CLKRST_PERI_CLK_CTRL03	0x3C
+#define  DSI_DPHY_CFG_CLK_EN		BIT(0)
+#define  DSI_DPHY_PLL_REFCLK_EN		BIT(1)
+#define  DSI_DPICLK_SRC_SEL_SHIFT	5	/* bits [6:5]: DPI clk src */
+/*
+ * Per ESP-IDF mipi_dsi_ll.h:mipi_dsi_ll_set_dpi_clock_source(), the
+ * encoding for bits [6:5] is:
+ *   0 = XTAL (40 MHz)
+ *   1 = PLL_F240M  (default — what IDF uses for ST7703)
+ *   2 = PLL_F160M
+ *   3 = APLL
+ * Earlier code mis-named value 1 as PLL_F160M; for the BONO panel
+ * IDF uses PLL_F240M / 5 = 48 MHz (very close to panel-spec 47 MHz),
+ * matching its golden register dump.
+ */
+#define  DSI_DPICLK_SRC_PLL_F240M	(1u << 5)	/* value 1 */
+#define  DSI_DPICLK_SRC_PLL_F160M	(2u << 5)	/* value 2 (kept for ref) */
+#define  DSI_DPICLK_EN			BIT(7)	/* DPI clock enable */
+#define  DSI_DPICLK_DIV_NUM_SHIFT	8	/* bits [15:8]: divider */
+#define HP_SYS_CLKRST_HP_RST_EN0	0xC0
+#define  RST_EN_DSI_BRG			BIT(26)
+#define  RST_EN_GDMA			BIT(21)	/* DW-GDMA module reset */
+
+/*
+ * PMU external LDO channel 3 (MIPI DSI PHY analog supply, 2500 mV).
+ *
+ * Boot shim doesn't enable LDO3 (our gate 5a/5b "backlight" was the
+ * keyboard LED bleed-through; the DSI PHY's analog section never had
+ * power). Without this, the PHY's digital register block is reachable
+ * — hence readable PHY_STATUS bits — but the PLL will never lock and
+ * writes to PHY_RSTZ do not unstick the status.
+ *
+ * Register layout (hw_ver1/soc/pmu_reg.h):
+ *   DR_REG_PMU_BASE       = DR_REG_LPAON_BASE (0x50110000) + 0x5000
+ *                         = 0x50115000
+ *   P0_0P2A_REG     @ +0x1c0  (ext_ldo[1] = LDO unit 2 = channel 3)
+ *     bit  7      FORCE_TIEH_SEL   (1 = SW-owned)
+ *     bit  8      XPD              (1 = enable)
+ *     bits 11:9   TIEH_SEL         (0 = use tieh)
+ *     bit 14      TIEH             (0 = Vref*Mul, not 3.3V bypass)
+ *   P0_0P2A_ANA_REG @ +0x1c4
+ *     bits 25:23  MUL
+ *     bit 26      EN_VDET          (ripple suppression)
+ *     bits 31:28  DREF
+ *
+ * For 2500 mV with no-eFuse-calibration fallback math (matches
+ * ldo_ll_voltage_to_dref_mul): DREF=9, MUL=6. Verified in Python.
+ *
+ * This belongs in a proper P4 LDO regulator driver; putting it here is
+ * diagnostic-only, just to answer "does the PHY PLL actually lock once
+ * analog supply exists." If this lights up PHY_STATUS.PHY_LOCK, the
+ * regulator-fixed stub in our DTS is a lie and needs replacing.
+ */
+#define ESP32P4_PMU_BASE		0x50115000
+#define ESP32P4_PMU_SIZE		0x1000
+#define PMU_EXT_LDO_P0_0P2A_REG		0x1c0
+#define PMU_EXT_LDO_P0_0P2A_ANA_REG	0x1c4
+#define  PMU_0P2A_FORCE_TIEH_SEL	BIT(7)
+#define  PMU_0P2A_XPD			BIT(8)
+#define  PMU_0P2A_TIEH_SEL_MASK		(0x7 << 9)
+#define  PMU_0P2A_TIEH			BIT(14)
+#define  PMU_ANA_0P2A_MUL_SHIFT		23
+#define  PMU_ANA_0P2A_MUL_MASK		(0x7 << PMU_ANA_0P2A_MUL_SHIFT)
+#define  PMU_ANA_0P2A_EN_VDET		BIT(26)
+#define  PMU_ANA_0P2A_DREF_SHIFT	28
+#define  PMU_ANA_0P2A_DREF_MASK		(0xF << PMU_ANA_0P2A_DREF_SHIFT)
+
+/*
+ * Espressif bridge registers (offset from the "bridge" reg range base,
+ * DR_REG_DSI_BRG_BASE = 0x500A0800).
+ *
+ * Derived from ESP-IDF:
+ *   soc/esp32p4/register/hw_ver1/soc/mipi_dsi_bridge_reg.h (offsets)
+ *   hal/esp32p4/include/hal/mipi_dsi_brg_ll.h (bit field semantics)
+ *   esp_lcd/dsi/esp_lcd_panel_dpi.c (initialization sequence)
+ */
+/*
+ * DSI_BRG_CLK_EN (bridge offset 0x000) — bit 0: "force_on of dsi_bridge
+ * register clock gate". Default 0 = dynamically gated (APB access-only).
+ * Must be set to 1 before any DSI activity so the bridge's operational
+ * clock is always-on; without it the DW host FIFO drain stalls because
+ * the bridge never forwards packets to the PHY.
+ * Mirrors mipi_dsi_brg_ll_force_enable_reg_clock(dev, true) in IDF.
+ */
+#define DSI_BRG_CLK_EN		0x000	/* bit 0: force bridge clock always-on */
+#define DSI_BRG_EN		0x004	/* bit 0: module enable */
+#define DSI_BRG_DMA_REQ_CFG	0x008	/* bits [11:0]: dma_burst_len (64-bit words) */
+#define DSI_BRG_RAW_NUM_CFG	0x00c	/* bits [21:0]: raw_num_total (pixel_bits/64)
+					 * bit  31: write 1 to reload counter */
+#define DSI_BRG_PIXEL_TYPE	0x018	/* bits [3:0]: raw_type (0=RGB888,1=RGB666,2=RGB565)
+					 * bits [5:4]: dpi_config
+					 * bit  6:    data_in_type (0=RGB,1=YUV) */
+#define  DSI_BRG_RAW_TYPE_RGB888	0u
+#define  DSI_BRG_RAW_TYPE_RGB565	2u
+#define DSI_BRG_DPI_V_CFG0	0x030	/* bits [11:0]: vtotal; bits [27:16]: vdisp */
+#define DSI_BRG_DPI_V_CFG1	0x034	/* bits [11:0]: vbank (=vbp); bits [27:16]: vsync (=vsw) */
+#define DSI_BRG_DPI_H_CFG0	0x038	/* bits [11:0]: htotal; bits [27:16]: hdisp */
+#define DSI_BRG_DPI_H_CFG1	0x03c	/* bits [11:0]: hbank (=hbp); bits [27:16]: hsync (=hsw) */
+#define DSI_BRG_DPI_MISC_CFG	0x040	/* bit  0:     dpi_en
+					 * bits [15:4]: fifo_underrun_discard_vcnt */
+#define DSI_BRG_DPI_CFG_UPDATE	0x044	/* write 1 to latch all DPI timing shadow registers */
+#define DSI_BRG_DMA_FLOW_CTRL	0x088	/* bit  0:    flow controller (0=DMA, 1=bridge)
+					 * bits [7:4]: multiblk_num */
+#define DSI_BRG_ALMOST_EMPTY_THRD 0x08c /* bits [10:0]: FIFO almost-empty threshold */
+
+/*
+ * DW-GDMA — IDF refers to this as "DW_GDMA" / "Generic DMA".
+ *
+ * Base 0x50081000 = DR_REG_HPPERIPH0_BASE (0x50000000) + 0x81000.
+ * Per-channel block at offset 0x100, 0x100 bytes/channel, 4 channels total.
+ *
+ * Bridge's DMA target ("memory address" of the bridge FIFO from the DMA's
+ * point of view): 0x50105000. DW-GDMA's master port 0 routes there; master
+ * port 1 routes to L2MEM/PSRAM. Per-channel CTL field 'sms' (src master
+ * select) and 'dms' (dst master select): 0 = MIPI_DSI bridge, 1 = memory.
+ *
+ * For our DSI feed: src = framebuffer in PSRAM (sms=1, sinc=INCR), dst =
+ * bridge FIFO at 0x50105000 (dms=0, dinc=FIXED). Handshake periph for DSI
+ * is ID 0 (DW_GDMA_LL_HW_HANDSHAKE_PERIPH_DSI per IDF dw_gdma_ll.h).
+ */
+#define ESP32P4_GDMA_BASE		0x50081000
+#define ESP32P4_GDMA_SIZE		0x500
+#define ESP32P4_DSI_BRG_MEM_BASE	0x50105000
+
+/*
+ * ESP32-P4 cache coherency for DMA buffers in PSRAM.
+ *
+ * Linux's arch_sync_dma_for_device() on this build is a NOP — it relies
+ * on Zicbom (cbo.clean) which our `-march=rv32imac` build doesn't have.
+ * The P4 has its own MMIO cache controller, exposed through ROM helpers
+ * at fixed addresses. We call them directly. Map bits: L1_DCACHE=BIT(4),
+ * L2_CACHE=BIT(5); we always pass 0x30 to flush both.
+ */
+#define ESP32P4_CACHE_MAP_L1D_L2	0x30
+typedef int (*esp32p4_cache_op_t)(u32 map, u32 addr, u32 size);
+#define esp32p4_cache_writeback ((esp32p4_cache_op_t)0x4fc003f4)
+#define esp32p4_cache_invalidate ((esp32p4_cache_op_t)0x4fc003e4)
+
+static inline void esp32p4_dsi_psram_flush(const void *vaddr, size_t size)
+{
+	esp32p4_cache_writeback(ESP32P4_CACHE_MAP_L1D_L2, (u32)vaddr, size);
+}
+static inline void esp32p4_dsi_psram_invalidate(const void *vaddr, size_t size)
+{
+	esp32p4_cache_invalidate(ESP32P4_CACHE_MAP_L1D_L2, (u32)vaddr, size);
+}
+
+/* Top-level GDMA registers */
+#define GDMA_CFG0			0x010	/* bit 0: dmac_en, bit 1: int_en */
+#define GDMA_CHEN0			0x018	/* bits[3:0] = ch_en, bits[11:8] = ch_en_we */
+#define GDMA_RESET0			0x058	/* bit 0: dmac_rst */
+
+/* Per-channel block: ESP32P4_GDMA_BASE + 0x100 + chan*0x100 + offset */
+#define GDMA_CH_OFFSET(chan)		(0x100 + (chan) * 0x100)
+#define GDMA_CH_SAR0			0x000
+#define GDMA_CH_SAR1			0x004
+#define GDMA_CH_DAR0			0x008
+#define GDMA_CH_DAR1			0x00c
+#define GDMA_CH_BLOCK_TS0		0x010	/* bits[21:0]: block_ts (N-1) */
+#define GDMA_CH_CTL0			0x018
+#define GDMA_CH_CTL1			0x01c
+#define GDMA_CH_CFG0			0x020
+#define GDMA_CH_CFG1			0x024
+#define GDMA_CH_LLP0			0x028
+#define GDMA_CH_LLP1			0x02c
+#define GDMA_CH_INTSTATENA0		0x080
+#define GDMA_CH_INTSTATENA1		0x084
+#define GDMA_CH_INTSIGENA0		0x090
+#define GDMA_CH_INTSIGENA1		0x094
+
+/* CFG0 bits — multi-block type encoding (per IDF dw_gdma_types.h):
+ *   0 = CONTIGUOUS, 1 = RELOAD, 2 = SHADOW, 3 = LIST.
+ * We want LIST (=3). Anything else and the engine ignores LLP and fires
+ * SHADOWREG_OR_LLI_INVALID_ERR (INT_ST0 bit 13). */
+#define GDMA_CFG0_SRC_MULTIBLK_LIST	(3u << 0)
+#define GDMA_CFG0_DST_MULTIBLK_LIST	(3u << 2)
+
+/* CFG1 bits */
+#define GDMA_CFG1_TT_FC_M2P_DMAC	1u		/* mem→periph, DMA itself is FC */
+#define GDMA_CFG1_TT_FC_M2P_DST		6u		/* mem→periph, dst is FC */
+#define GDMA_CFG1_HS_SEL_SRC_HW		(0u << 3)	/* HW handshake (default) */
+#define GDMA_CFG1_HS_SEL_DST_HW		(0u << 4)
+#define GDMA_CFG1_DST_PER_DSI		(0u << 12)	/* periph ID 0 = DSI */
+#define GDMA_CFG1_CH_PRIOR(p)		(((p) & 7u) << 17)
+#define GDMA_CFG1_SRC_OSR_LMT(n)	((((n) - 1) & 0xfu) << 23)
+#define GDMA_CFG1_DST_OSR_LMT(n)	((((n) - 1) & 0xfu) << 27)
+
+/* CTL0 bits (LLI control word low) */
+#define GDMA_CTL0_SMS_MEMORY		(1u << 0)
+#define GDMA_CTL0_DMS_DSI		(0u << 2)
+#define GDMA_CTL0_SINC_INCR		(0u << 4)
+#define GDMA_CTL0_DINC_FIXED		(1u << 6)
+#define GDMA_CTL0_TR_WIDTH_64		3u		/* 64-bit transfers */
+#define GDMA_CTL0_SRC_TR_WIDTH(w)	(((w) & 7u) << 8)
+#define GDMA_CTL0_DST_TR_WIDTH(w)	(((w) & 7u) << 11)
+#define GDMA_CTL0_MSIZE_512		9u
+#define GDMA_CTL0_MSIZE_256		8u
+#define GDMA_CTL0_SRC_MSIZE(m)		(((m) & 0xfu) << 14)
+#define GDMA_CTL0_DST_MSIZE(m)		(((m) & 0xfu) << 18)
+
+/* CTL1 bits (LLI control word high) */
+#define GDMA_CTL1_ARLEN_EN		BIT(6)
+#define GDMA_CTL1_ARLEN(n)		((((n) - 1) & 0xffu) << 7)
+#define GDMA_CTL1_AWLEN_EN		BIT(15)
+#define GDMA_CTL1_AWLEN(n)		((((n) - 1) & 0xffu) << 16)
+#define GDMA_CTL1_LLI_LAST		BIT(30)
+#define GDMA_CTL1_LLI_VALID		BIT(31)
+
+/* CHEN0 write-enable mask + value: enable channel N */
+#define GDMA_CHEN_ENABLE(chan)		((1u << (chan)) | (1u << (8 + (chan))))
+
+/*
+ * DW-GDMA Link List Item (LLI). Hardware-defined layout, 64 bytes,
+ * must be 64-byte aligned. We use the same layout as IDF's
+ * dw_gdma_link_list_item_t (defined in IDF's hal/dw_gdma_ll.h).
+ *
+ * For loop-forever single-LLI operation: set llp.loc = self_addr >> 6,
+ * ctl1.lli_valid = 1, ctl1.lli_last = 0. Engine reads LLI, executes,
+ * fetches next (which is self), reads again, executes... forever.
+ */
+struct esp32p4_gdma_lli {
+	u32 sar0, sar1;		/* source address, low/high */
+	u32 dar0, dar1;		/* dest address, low/high */
+	u32 block_ts0;		/* bits[21:0] = block_ts (N-1) */
+	u32 reserved_14;
+	u32 llp0, llp1;		/* link-list pointer (loc0 in bits[31:6], lms bit 0) */
+	u32 ctl0, ctl1;
+	u32 sstat;
+	u32 dstat;
+	u32 status0, status1;
+	u32 reserved_38, reserved_3c;
+} __aligned(64);
+
+/*
+ * DW-MIPI-DSI host registers written by our phy_power_on to override the
+ * LP-vs-HS command-mode configuration set by the DW bridge's own set_mode().
+ */
+#define DW_MIPI_DSI_CMD_MODE_CFG		0x068	/* per-packet LP/HS select */
+#define DW_MIPI_DSI_LPCLK_CTRL			0x094
+#define  LPCLK_TXREQUESTCLKHS			BIT(0)
+
+#define DW_MIPI_DSI_MODE_CFG			0x034
+#define DW_MIPI_DSI_MODE_CFG_VIDEO		0x0
+
+/*
+ * DW-MIPI-DSI host registers used to drive the D-PHY.
+ *
+ * Our phy_ops->init runs from inside the DW bridge driver, which brackets
+ * our callback with PHY_RSTZ / PHY_TST_CTRL0 sequencing of its own. All we
+ * do here is push PLL configuration bytes through the PHY test interface
+ * (see esp32p4_dsi_phy_write_reg below). The bridge then sets
+ * PHY_SHUTDOWNZ | PHY_RSTZ | PHY_ENABLECLK | PHY_FORCEPLL itself and polls
+ * PHY_STATUS for lock; we duplicate the lock poll in phy_power_on purely
+ * as a diagnostic, because "PLL never locked" vs "PLL locked but no HS
+ * traffic yet" are two very different failure modes and the bridge driver
+ * doesn't log which one it hit.
+ */
+#define DW_MIPI_DSI_PHY_RSTZ			0x0A0
+#define  PHY_RSTZ_SHUTDOWNZ			BIT(0)
+#define  PHY_RSTZ_RSTZ				BIT(1)
+#define  PHY_RSTZ_ENABLECLK			BIT(2)
+#define  PHY_RSTZ_FORCEPLL			BIT(3)
+#define DW_MIPI_DSI_PHY_IF_CFG			0x0A4
+#define DW_MIPI_DSI_PHY_STATUS			0x0B0
+#define  PHY_STATUS_PHY_LOCK			BIT(0)
+#define  PHY_STATUS_STOP_STATE_CLK_LANE		BIT(2)
+#define DW_MIPI_DSI_PHY_TST_CTRL0		0x0B4
+#define  PHY_TST_CTRL0_TESTCLK			BIT(1)
+#define  PHY_TST_CTRL0_TESTCLR			BIT(0)
+#define DW_MIPI_DSI_PHY_TST_CTRL1		0x0B8
+#define  PHY_TST_CTRL1_TESTEN			BIT(16)
+
+/*
+ * D-PHY PLL configuration for the BONO panel.
+ *
+ * ESP-IDF legacy default picks MIPI_DSI_PHY_PLLREF_CLK_SRC = PLL_F20M
+ * (20 MHz); our boot shim inherits that because we haven't written a P4
+ * clock-controller driver yet. Target lane rate is 1000 Mbps.
+ *
+ * IDF's mipi_dsi_hal_configure_phy_pll() programs M and N such that
+ *
+ *   lane_bit_rate_mbps = f_ref_mhz * M / N
+ *
+ * — i.e. it treats VCO and lane bit rate as the same number. Despite what
+ * the canonical DW PHY datasheet says about VCO = 2 × lane_bitrate, this
+ * is what works on the ESP32-P4 silicon at hs_freq_range_sel = 0x2A; an
+ * earlier version of this driver did the textbook math and ended up
+ * programming the PLL for 2 Gbps with hs_freq_range telling the analog
+ * block we wanted 1 Gbps. LP-mode DCS still got through (LP path
+ * bypasses the PLL) but HS video bursts rendered nothing — exactly the
+ * symptom we chased for two days.
+ *
+ * For ref=20 MHz, target=1000 Mbps: M = 50, N = 1.
+ *
+ * Constraints checked by the IDF HAL search (we pre-compute because we
+ * only support one lane rate):
+ *   - M must be even (50 ✓)
+ *   - 5 MHz <= f_ref/N <= 40 MHz  (20/1 = 20 MHz ✓)
+ *
+ * Test-interface register recipe is from ESP-IDF's
+ * mipi_dsi_hal_configure_phy_pll() in components/hal/mipi_dsi_hal.c. The
+ * split write to reg 0x18 is how the PHY latches a 9-bit M-1: low 5 bits
+ * first, then high 4 bits with bit 7 set. hs_freq_range_sel lookup for
+ * the 1000-1049 Mbps bucket is 0x2A (mipi_dsi_periph.c).
+ */
+#define DSI_PLL_N				1
+#define DSI_PLL_M				50
+#define DSI_PLL_HS_FREQ_RANGE_SEL		0x2A
+
+#define DSI_PHY_REG_HS_FREQ_RANGE		0x44
+#define DSI_PHY_REG_PLL_MAGIC			0x19	/* ESP-IDF writes 0x30 */
+#define DSI_PHY_REG_PLL_N			0x17
+#define DSI_PHY_REG_PLL_M			0x18
+
+/*
+ * BONO panel (WHY2025 v2.1) — 2 data lanes at 1 Gbps. Values come from
+ * linux-native-scratch/main/main.c:
+ *   LCD_MIPI_DSI_LANE_NUM            = 2
+ *   LCD_MIPI_DSI_LANE_BITRATE_MBPS   = 1000
+ */
+#define ESP32P4_DSI_MAX_LANES			2
+#define ESP32P4_DSI_LANE_MBPS			1000
+
+struct esp32p4_dsi {
+	struct drm_device drm;		/* owns /dev/dri/cardN */
+	struct drm_simple_display_pipe pipe;
+	struct device *dev;
+
+	void __iomem *host_regs;	/* DW-MIPI-DSI host, 0x500A0000 +0x800 */
+	void __iomem *bridge_regs;	/* Espressif bridge, 0x500A0800 +0x100 */
+	void __iomem *gdma_regs;	/* DW-GDMA, 0x50081000 +0x500 */
+
+	/* Static framebuffer + LLI for one-channel loop-forever DPI feed.
+	 * Allocated lazily on first dpi_enable_work; freed in remove. */
+	void *fb_cpu;
+	dma_addr_t fb_dma;
+	size_t fb_size;
+	struct esp32p4_gdma_lli *lli_cpu;
+	dma_addr_t lli_dma;
+	bool gdma_armed;
+
+	struct regulator *phy_supply;	/* LDO3 @ 2500 mV */
+	struct reset_control *rst;	/* optional */
+
+	struct dw_mipi_dsi *dmd;
+	struct dw_mipi_dsi_plat_data pdata;
+
+	/*
+	 * DPI output is enabled from a workqueue after the DW bridge
+	 * switches the host to video mode. pipe_enable fires before the
+	 * bridge chain (pre_enable → panel DCS → enable → MODE_CFG=video),
+	 * so all Espressif bridge register writes are deferred here to avoid
+	 * disturbing the DW host state during panel DCS init.
+	 */
+	struct delayed_work dpi_enable_work;
+	bool host_attached;	/* set by esp32p4_dsi_host_attach */
+	u32 hdisp_cache, vdisp_cache;
+	u32 hsw_cache, hbp_cache, hfp_cache;
+	u32 vsw_cache, vbp_cache, vfp_cache;
+
+	/*
+	 * fbdev client setup deferred to a workqueue.
+	 * drm_fbdev_dma's shadow path needs vzalloc(720*720*2) = 1 MB of
+	 * contiguous system memory. Calling drm_client_setup_with_fourcc
+	 * synchronously from probe loses to the BMI270/BME680 sensor probes
+	 * that fragment the buddy heap during their I²C-bit-banged init.
+	 * Defer 3 s to let the heap settle and initmem free.
+	 */
+	struct delayed_work fbdev_setup_work;
+};
+
+#define drm_to_esp32p4_dsi(d) container_of(d, struct esp32p4_dsi, drm)
+
+/* ---------- clock/reset audit ------------------------------------------ */
+
+/*
+ * Power on LDO3 @ 2500 mV for the MIPI-DSI PHY analog supply.
+ *
+ * Ports esp_ldo_acquire_channel(chan=3, 2500mV) from ESP-IDF by poking
+ * PMU ext_ldo[1] directly. dref=9, mul=6 match the no-eFuse-calibration
+ * fallback of ldo_ll_voltage_to_dref_mul for 2500 mV exactly (diff=0).
+ *
+ * Diagnostic-only; when a real P4 PMU/LDO driver lands this gets replaced
+ * by regulator_enable() on a properly-backed regulator.
+ */
+static void esp32p4_dsi_ldo3_enable(struct device *dev)
+{
+	void __iomem *pmu;
+	u32 ctrl_pre, ana_pre, ctrl_post, ana_post;
+
+	pmu = ioremap(ESP32P4_PMU_BASE, ESP32P4_PMU_SIZE);
+	if (!pmu) {
+		dev_warn(dev, "LDO3: PMU ioremap failed, skipping\n");
+		return;
+	}
+
+	ctrl_pre = readl(pmu + PMU_EXT_LDO_P0_0P2A_REG);
+	ana_pre  = readl(pmu + PMU_EXT_LDO_P0_0P2A_ANA_REG);
+
+	/* analog: MUL=6, DREF=9, EN_VDET=1 (ripple suppression) */
+	ana_post = ana_pre;
+	ana_post &= ~(PMU_ANA_0P2A_MUL_MASK | PMU_ANA_0P2A_DREF_MASK);
+	ana_post |= (6u << PMU_ANA_0P2A_MUL_SHIFT) & PMU_ANA_0P2A_MUL_MASK;
+	ana_post |= (9u << PMU_ANA_0P2A_DREF_SHIFT) & PMU_ANA_0P2A_DREF_MASK;
+	ana_post |= PMU_ANA_0P2A_EN_VDET;
+	writel(ana_post, pmu + PMU_EXT_LDO_P0_0P2A_ANA_REG);
+
+	/* control: clear TIEH (use Vref*Mul, not 3.3V bypass), TIEH_SEL=0,
+	 * FORCE_TIEH_SEL=1 (SW-owned), XPD=1 (enable) */
+	ctrl_post = ctrl_pre;
+	ctrl_post &= ~(PMU_0P2A_TIEH | PMU_0P2A_TIEH_SEL_MASK);
+	ctrl_post |= PMU_0P2A_FORCE_TIEH_SEL | PMU_0P2A_XPD;
+	writel(ctrl_post, pmu + PMU_EXT_LDO_P0_0P2A_REG);
+
+	/*
+	 * Let the LDO ramp before we try to run the PHY. ESP-IDF's
+	 * esp_ldo_acquire_channel returns synchronously; the HW power-on
+	 * delay targets are left at their reset defaults (~1 ms max). 5 ms
+	 * is a conservative round-up.
+	 */
+	mdelay(5);
+
+	iounmap(pmu);
+}
+
+/*
+ * Read, log, and (optionally) force the HP_SYS_CLKRST bits that gate the
+ * DSI subsystem. ESP-IDF does this inside esp_lcd_new_dsi_bus() via
+ * PERIPH_RCC_ATOMIC { mipi_dsi_ll_enable_bus_clock + _reset_register +
+ * _enable_phy_config_clock + _enable_phy_pllref_clock }. On Linux we
+ * don't have a P4 clock driver yet, so the boot shim is the only thing
+ * that might have enabled them — and we're not sure it does. If any of
+ * these bits are 0 at probe time, every subsequent host register write
+ * silently vanishes and the first DCS transfer will spin forever on
+ * GEN_CMD_EMPTY. That's the current gate-5 hang hypothesis.
+ *
+ * Behaviour:
+ *   1. ioremap the clkrst page
+ *   2. log pre-state of the three gating registers
+ *   3. force all three clock bits on, pulse the bridge reset
+ *   4. log post-state
+ *   5. unmap (we don't need to keep the mapping after probe)
+ *
+ * No DT binding required — these are SoC-level registers, not peripheral
+ * regs. When a proper esp32p4-clk driver lands, this gets replaced with
+ * clk_prepare_enable() + reset_control_reset().
+ */
+static void esp32p4_dsi_clkrst_audit(struct device *dev)
+{
+	void __iomem *clkrst;
+	u32 ctrl1_pre, ctrl03_pre;
+
+	clkrst = ioremap(ESP32P4_HP_SYS_CLKRST_BASE, ESP32P4_HP_SYS_CLKRST_SIZE);
+	if (!clkrst) {
+		dev_warn(dev, "clkrst audit: ioremap failed, skipping\n");
+		return;
+	}
+
+	ctrl1_pre  = readl(clkrst + HP_SYS_CLKRST_SOC_CLK_CTRL1);
+	ctrl03_pre = readl(clkrst + HP_SYS_CLKRST_PERI_CLK_CTRL03);
+
+	/*
+	 * Match ESP-IDF's HP_SYS_CLKRST state for the DSI subsystem. Dump of
+	 * a working IDF boot showed:
+	 *   SOC_CLK_CTRL1   = 0x0e041060  (DSI_SYS=1, GDMA=1, DMA2D=1)
+	 *   PERI_CLK_CTRL03 = 0x000004a3  (DPHY_CFG=1, PLL_REF=1,
+	 *                                   DPICLK_SRC_SEL=1, DPICLK_EN=1,
+	 *                                   DPICLK_DIV_NUM=4)
+	 * Our previous code only enabled DSI_SYS, DPHY_CFG, PLL_REF — missing
+	 * the DPI clock and the DMA clocks the bridge needs to feed the host.
+	 * Without DPICLK_EN the DSI host has no pixel clock; VPG pattern
+	 * generation stalls and any DPI input to the host is silent, which
+	 * matches our symptom (PHY HS up, but panel sees no valid packets).
+	 */
+	writel(ctrl1_pre | DSI_SYS_CLK_EN | GDMA_SYS_CLK_EN | DMA2D_SYS_CLK_EN,
+	       clkrst + HP_SYS_CLKRST_SOC_CLK_CTRL1);
+	/* DPI clock: source PLL_F240M, divider 5 → real = 48 MHz.
+	 * Mirrors IDF for the BONO ST7703 panel:
+	 *   panel spec dpi_clock_freq_mhz = 47
+	 *   div = round(240/47) = 5
+	 *   real = 48 MHz (matches panel within 2%)
+	 * Earlier we used SEL=1+div=3 thinking that was F160M/3 = 53.33 MHz,
+	 * but SEL=1 is actually F240M (per IDF mipi_dsi_ll_set_dpi_clock
+	 * _source), so we were running at 80 MHz — 70% over panel spec.
+	 * Panel cannot latch pixels at that rate; symptom is uniform black
+	 * / grey even though host emits HS bursts and panel reports
+	 * display_on. Going to 48 MHz aligns DPI clock with panel timing
+	 * AND with the host's VID_HLINE_TIME (computed by upstream from
+	 * mode->clock=47000, so 48 MHz is within rounding). */
+	writel((ctrl03_pre & ~(0xffu << DSI_DPICLK_DIV_NUM_SHIFT)) |
+	       DSI_DPHY_CFG_CLK_EN | DSI_DPHY_PLL_REFCLK_EN |
+	       DSI_DPICLK_SRC_PLL_F240M | DSI_DPICLK_EN |
+	       (0x05u << DSI_DPICLK_DIV_NUM_SHIFT),
+	       clkrst + HP_SYS_CLKRST_PERI_CLK_CTRL03);
+
+	/*
+	 * GDMA wiring: DW-GDMA needs both clocks (sys + cpu) AND a
+	 * reset pulse. Without GDMA_CPU_CLK_EN the controller's register
+	 * interface responds to writes (CHEN0 read-back showed the right
+	 * bit set) but the channel's transfer engine never starts — the LLI
+	 * is never fetched, SAR/DAR/BLOCK_TS stay 0. SOC_CLK_CTRL0 bit 13
+	 * is the missing bit.
+	 */
+	{
+		u32 ctrl0 = readl(clkrst + HP_SYS_CLKRST_SOC_CLK_CTRL0);
+
+		writel(ctrl0 | GDMA_CPU_CLK_EN,
+		       clkrst + HP_SYS_CLKRST_SOC_CLK_CTRL0);
+	}
+
+	/*
+	 * Pulse the DSI bridge reset and the DW-GDMA module reset: bit set
+	 * to 1, then back to 0. ESP-IDF does this for both. We read-modify
+	 * -write to avoid disturbing the other 30 reset bits in HP_RST_EN0.
+	 */
+	{
+		u32 rst = readl(clkrst + HP_SYS_CLKRST_HP_RST_EN0);
+		u32 mask = RST_EN_DSI_BRG | RST_EN_GDMA;
+
+		writel(rst |  mask, clkrst + HP_SYS_CLKRST_HP_RST_EN0);
+		writel(rst & ~mask, clkrst + HP_SYS_CLKRST_HP_RST_EN0);
+	}
+
+	/* Boot shim does not pre-enable the DSI gates; the writes above
+	 * unconditionally force them on. No need to warn — the audit IS the
+	 * fix until a real ESP32-P4 clk driver lands. */
+	(void)ctrl1_pre;
+	(void)ctrl03_pre;
+
+	iounmap(clkrst);
+}
+
+/* ---------- PHY ops ----------------------------------------------------- */
+
+/*
+ * DW MIPI D-PHY test interface: bit-banged two-phase protocol.
+ *
+ *   address phase: TESTEN=1, data[7:0] = regaddr, pulse TESTCLK
+ *   data phase:    TESTEN=0, data[7:0] = regval,  pulse TESTCLK
+ *
+ * The "pulse TESTCLK" sequence the Synopsys reference driver uses (and
+ * ESP-IDF matches via write_clock(0) / write_clock(1) / write_clock(0))
+ * is clock-low → clock-high → clock-low between each write. We inline
+ * that rather than factoring helpers; the phase boundary matters and a
+ * helper hides it.
+ */
+static void esp32p4_dsi_phy_write_reg(struct esp32p4_dsi *dsi, u8 reg, u8 val)
+{
+	void __iomem *h = dsi->host_regs;
+
+	/* address phase */
+	writel(0, h + DW_MIPI_DSI_PHY_TST_CTRL0);
+	writel(PHY_TST_CTRL1_TESTEN | reg, h + DW_MIPI_DSI_PHY_TST_CTRL1);
+	writel(PHY_TST_CTRL0_TESTCLK, h + DW_MIPI_DSI_PHY_TST_CTRL0);
+	writel(0, h + DW_MIPI_DSI_PHY_TST_CTRL0);
+
+	/* data phase */
+	writel(val, h + DW_MIPI_DSI_PHY_TST_CTRL1);
+	writel(PHY_TST_CTRL0_TESTCLK, h + DW_MIPI_DSI_PHY_TST_CTRL0);
+	writel(0, h + DW_MIPI_DSI_PHY_TST_CTRL0);
+}
+
+static int esp32p4_dsi_phy_init(void *priv_data)
+{
+	struct esp32p4_dsi *dsi = priv_data;
+
+	/*
+	 * The DW bridge driver enters here with PHY_RSTZ/SHUTDOWNZ/ENABLECLK
+	 * deasserted and the test interface held in reset (TESTCLR=1). It
+	 * clears TESTCLR right before calling us, so we can push bytes
+	 * immediately.
+	 *
+	 * Sequence is the same as ESP-IDF mipi_dsi_hal_configure_phy_pll():
+	 *   0x44: hs_freq_range << 1    (1000-1049 Mbps bucket = 0x2A)
+	 *   0x19: 0x30                  (PLL analog magic per vendor)
+	 *   0x17: N - 1
+	 *   0x18: (M - 1) & 0x1F        (low five bits)
+	 *   0x18: 0x80 | (((M-1) >> 5) & 0x0F)  (high bits, latch on bit 7)
+	 */
+	esp32p4_dsi_phy_write_reg(dsi, DSI_PHY_REG_HS_FREQ_RANGE,
+				  DSI_PLL_HS_FREQ_RANGE_SEL << 1);
+	esp32p4_dsi_phy_write_reg(dsi, DSI_PHY_REG_PLL_MAGIC, 0x30);
+	esp32p4_dsi_phy_write_reg(dsi, DSI_PHY_REG_PLL_N, DSI_PLL_N - 1);
+	esp32p4_dsi_phy_write_reg(dsi, DSI_PHY_REG_PLL_M,
+				  (DSI_PLL_M - 1) & 0x1F);
+	esp32p4_dsi_phy_write_reg(dsi, DSI_PHY_REG_PLL_M,
+				  0x80 | (((DSI_PLL_M - 1) >> 5) & 0x0F));
+	return 0;
+}
+
+static void esp32p4_dsi_phy_power_on(void *priv_data)
+{
+	struct esp32p4_dsi *dsi = priv_data;
+	void __iomem *h = dsi->host_regs;
+	u32 status;
+	int i;
+
+	/*
+	 * The DW bridge sets PHY_ENABLECLK|FORCEPLL|SHUTDOWNZ|RSTZ and then
+	 * busy-waits for PHY_LOCK itself, so we're just here to record what
+	 * actually happened — if the lock never asserts we want that in the
+	 * log before the bridge's own (silent) timeout expires.
+	 */
+	for (i = 0; i < 1000; i++) {
+		status = readl(h + DW_MIPI_DSI_PHY_STATUS);
+		if (status & PHY_STATUS_PHY_LOCK)
+			break;
+		udelay(10);
+	}
+
+	if (!(status & PHY_STATUS_PHY_LOCK))
+		dev_warn(dsi->dev,
+			 "phy_power_on: PLL did not lock after 10ms (PHY_STATUS=%#x)\n",
+			 status);
+	else
+		dev_dbg(dsi->dev,
+			"phy_power_on: PHY_STATUS=%#x lock=1 stop_clk=%d after %dx10us\n",
+			status,
+			!!(status & PHY_STATUS_STOP_STATE_CLK_LANE),
+			i);
+
+	/*
+	 * Clear TXREQUESTCLKHS to put the clock lane into LP-Stop (LP-11).
+	 *
+	 * Panel DCS init runs in LP escape mode: the panel descriptor sets
+	 * MIPI_DSI_MODE_LPM, which causes mipi_dsi_device_transfer() to add
+	 * MIPI_DSI_MSG_USE_LPM to every message, which causes
+	 * dw_mipi_message_config() to write CMD_MODE_ALL_LP to CMD_MODE_CFG
+	 * before each transfer. LP escape requires the clock lane in LP-11;
+	 * driving a continuous HS byte clock while attempting LP escape causes
+	 * the panel to miss the LP-01 escape-entry sequence and discard the
+	 * command, which is why every DCS write returned -ETIMEDOUT.
+	 *
+	 * IDF confirms this: esp_lcd_mipi_dsi_bus.c sets clock lane to
+	 * CLOCK_LANE_STATE_LP before DCS, and esp_lcd_panel_io_dbi.c marks
+	 * all 12 DCS packet types as MIPI_DSI_LL_TRANS_SPEED_LP.
+	 *
+	 * dw_mipi_dsi_set_mode(CMD) (called before us) writes
+	 * LPCLK_CTRL=TXREQUESTCLKHS=1; clear it here. Poll until the PHY
+	 * confirms LP-11 so the first DCS write doesn't race the state machine.
+	 *
+	 * Note: DSI_BRG_EN is NOT set here. The bridge is only in the DPI
+	 * video path; esp32p4_dsi_dpi_enable_work() sets it at the right time
+	 * (after the 400ms panel DCS init window). IDF likewise does not set
+	 * DSI_BRG_EN during DCS command mode.
+	 */
+	writel(0, h + DW_MIPI_DSI_LPCLK_CTRL);
+
+	for (i = 0; i < 500; i++) {
+		status = readl(h + DW_MIPI_DSI_PHY_STATUS);
+		if (status & PHY_STATUS_STOP_STATE_CLK_LANE)
+			break;
+		udelay(10);
+	}
+
+	if (!(status & PHY_STATUS_STOP_STATE_CLK_LANE))
+		dev_warn(dsi->dev,
+			 "clock lane failed to enter LP-Stop after 5ms: PHY_STATUS=%#x\n",
+			 status);
+
+	/*
+	 * v5 reorder: the Espressif bridge is NOT enabled here.
+	 *
+	 * Previously we enabled the bridge in phy_power_on to provide DPI
+	 * blanking windows for LP DCS during VIDEO mode. Instrumentation
+	 * proved that theory wrong: with the bridge enabled and MODE_CFG=VIDEO,
+	 * LP DCS got stuck in GEN_BUFF (CMD_PKT_STATUS bits 17/19) and never
+	 * transmitted on the wire — panel never received its init sequence.
+	 *
+	 * ESP-IDF's proven flow: keep MODE_CFG=CMD and bridge OFF during panel
+	 * DCS init; enable bridge + flip to VIDEO only after DCS completes.
+	 * We match that by (a) setting plat_data->defer_video_mode_switch so
+	 * the DW core skips set_mode(VIDEO) in atomic_enable, and (b) moving
+	 * bridge enable into esp32p4_dsi_dpi_enable_work, scheduled far enough
+	 * after pipe_enable (2 s) that panel .enable has finished.
+	 */
+}
+
+static void esp32p4_dsi_phy_power_off(void *priv_data)
+{
+	struct esp32p4_dsi *dsi = priv_data;
+
+	dev_dbg(dsi->dev, "phy_power_off (stub)\n");
+}
