+
+static void esp32p4_dsi_dpi_enable_work(struct work_struct *work)
+{
+	struct esp32p4_dsi *dsi =
+		container_of(to_delayed_work(work), struct esp32p4_dsi,
+			     dpi_enable_work);
+	void __iomem *h = dsi->host_regs;
+	void __iomem *b = dsi->bridge_regs;
+	u32 hdisp  = dsi->hdisp_cache;
+	u32 vdisp  = dsi->vdisp_cache;
+	u32 hsw    = dsi->hsw_cache;
+	u32 hbp    = dsi->hbp_cache;
+	u32 hfp    = dsi->hfp_cache;
+	u32 vsw    = dsi->vsw_cache;
+	u32 vbp    = dsi->vbp_cache;
+	/*
+	 * IDF HAL compensates bridge HFP for DPI clock rounding:
+	 *   compensation = round(real_dpi/expected_dpi * htotal) - htotal
+	 *   bridge_hfp_compensated = hfp + compensation
+	 * With our (now-corrected) PLL_F240M / 5 = 48 MHz real, panel spec
+	 * 47 MHz, htotal=1006:
+	 *   round(48/47 * 1006) - 1006 = 1027 - 1006 = +21
+	 * This matches the IDF golden bridge htotal of 1027 captured by
+	 * linux-native-scratch. Earlier code used +136 — that was the
+	 * compensation for the buggy PLL_F240M/3 = 80 MHz path; once the
+	 * clock is corrected, only +21 is needed.
+	 */
+	u32 hfp_compensated = hfp + 21;
+	u32 htotal = hdisp + hsw + hbp + hfp_compensated;
+	u32 vtotal = vdisp + vsw + vbp + dsi->vfp_cache;
+	u32 raw_num = hdisp * vdisp / 4;
+
+	/*
+	 * Program the Espressif DPI bridge — previously in phy_power_on().
+	 * Timing registers, pixel type, DMA flow control, FIFO thresholds,
+	 * then DSI_BRG_EN=1 and DPI_MISC_CFG.dpi_en=1. This is equivalent to
+	 * IDF's dpi_panel_init() register sequence.
+	 */
+	writel((vdisp << 16) | vtotal,  b + DSI_BRG_DPI_V_CFG0);
+	writel((vsw   << 16) | vbp,     b + DSI_BRG_DPI_V_CFG1);
+	writel((hdisp << 16) | htotal,  b + DSI_BRG_DPI_H_CFG0);
+	writel((hsw   << 16) | hbp,     b + DSI_BRG_DPI_H_CFG1);
+	writel(DSI_BRG_RAW_TYPE_RGB565, b + DSI_BRG_PIXEL_TYPE);
+	/*
+	 * DMA_FLOW_CTRL bits:
+	 *   [0]    dsi_dma_flow_controller  — 0: DMAC; 1: dsi_bridge
+	 *   [7:4]  dma_flow_multiblk_num    — IDF sets 1
+	 *
+	 * GDMA wiring: DW-GDMA is now wired up (esp32p4_dsi_gdma_arm
+	 * below). DMAC = flow controller, multi_block_num=1 to match IDF.
+	 */
+	writel((0u << 0) | (1u << 4),   b + DSI_BRG_DMA_FLOW_CTRL);
+	writel(raw_num | BIT(31),       b + DSI_BRG_RAW_NUM_CFG);
+	writel(256u,                    b + DSI_BRG_DMA_REQ_CFG);
+	writel(1024u - 256u,            b + DSI_BRG_ALMOST_EMPTY_THRD);
+	/* IDF order: bridge enable + DPI config first WITHOUT dpi_en, then
+	 * GDMA arm, then host into VIDEO mode, then flip dpi_en at the end.
+	 * This avoids the bridge driving DPI sync into a host that's not yet
+	 * in video mode. */
+	writel((hdisp << 4) & 0xFFFF0,  b + DSI_BRG_DPI_MISC_CFG); /* dpi_en=0 */
+	writel(BIT(0),                  b + DSI_BRG_EN);
+	writel(BIT(0),                  b + DSI_BRG_DPI_CFG_UPDATE);
+
+	/* Arm DW-GDMA: allocates fb, fills colour bars, points channel 0
+	 * at a self-looping LLI feeding the bridge FIFO. After this, the
+	 * bridge has a continuous DPI pixel source and the DW host can
+	 * generate real HS video packets. */
+	if (esp32p4_dsi_gdma_arm(dsi))
+		dev_err(dsi->dev, "GDMA arm failed; bridge will starve\n");
+
+	/*
+	 * Mirror IDF golden PHY_IF_CFG: phy_stop_wait_time = 0x3f, not the
+	 * 0x20 reset default the upstream DW core leaves in place. Without
+	 * this the panel may not detect the LP→HS edge cleanly on every
+	 * frame and silently drop the entire video burst.
+	 */
+	writel((0x3fu << 8) | (ESP32P4_DSI_MAX_LANES - 1), h + 0xa4);
+
+	/*
+	 * CLKMGR_CFG (0x08): IDF golden = 0x0d07 (tx_esc_clk_div=7,
+	 * to_clk_div=13). Upstream sets tx_esc_clk_div but leaves
+	 * to_clk_div at reset (0), which gates timeout-driven state
+	 * machines (BTA, LP escape, video-mode FSM transitions) at "never".
+	 */
+	writel((readl(h + 0x08) & ~0xff00u) | (13u << 8), h + 0x08);
+
+	/*
+	 * Hand the DW host over to VIDEO mode. set_mode(VIDEO) inside the
+	 * DW core: PWR_UP=RESET, MODE_CFG=0, video_mode_config,
+	 * LPCLK_CTRL=TXREQUESTCLKHS (clock lane to HS), PWR_UP=POWERUP.
+	 * After this, the host starts consuming DPI sync from the bridge
+	 * and pushes HS video packets onto the data lanes.
+	 */
+	dw_mipi_dsi_late_enable_video(dsi->dmd);
+
+	/* Final step: NOW flip dpi_en on the bridge so it starts driving the
+	 * DPI sync into the host's now-VIDEO-mode input. Mirror IDF order. */
+	writel(((hdisp << 4) & 0xFFFF0) | BIT(0), b + DSI_BRG_DPI_MISC_CFG);
+	writel(BIT(0),                            b + DSI_BRG_DPI_CFG_UPDATE);
+
+	/*
+	 * Let video stream settle for ~5 frames at 60 Hz before flipping
+	 * VID_MODE_CFG below. Toggling LP_CMD_EN mid-burst confuses the
+	 * host's VBI scheduler.
+	 */
+	msleep(90);
+
+	/*
+	 * VID_MODE_CFG.LP_CMD_EN (BIT 15) lets DCS commands flow in LP
+	 * escape during VBI while video is active. FRAME_BTA_ACK_EN
+	 * (BIT 14) lets the host take the bus back cleanly after panel
+	 * BTA. IDF golden VID_MODE_CFG = 0xff02.
+	 */
+	writel(readl(h + 0x38) | BIT(15) | BIT(14), h + 0x38);
+
+	/*
+	 * Catch-up blit. Atomic commits that fired before fb_cpu was
+	 * allocated (gdma_arm above) had nowhere to land — pipe_update's
+	 * skip path returned without copying. Now that fb_cpu exists,
+	 * copy whatever's currently committed in plane.state->fb so
+	 * fbcon's boot output replaces the test pattern. Without this,
+	 * the panel shows the test pattern (white) forever, since fbcon
+	 * doesn't trigger another commit after boot finishes.
+	 */
+	{
+		struct drm_plane_state *st = dsi->pipe.plane.state;
+
+		esp32p4_dsi_blit_fb(dsi, st ? st->fb : NULL,
+				    st ? (st->src_y >> 16) : 0);
+	}
+}
+
+static void esp32p4_dsi_pipe_enable(struct drm_simple_display_pipe *pipe,
+				     struct drm_crtc_state *crtc_state,
+				     struct drm_plane_state *plane_state)
+{
+	struct esp32p4_dsi *dsi = container_of(pipe, struct esp32p4_dsi, pipe);
+	const struct drm_display_mode *mode = &crtc_state->mode;
+
+	/*
+	 * pipe_enable fires in the CRTC loop of drm_atomic_helper_commit_
+	 * modeset_enables(), BEFORE the connector/encoder loop that calls
+	 * drm_atomic_bridge_chain_pre_enable (PHY init + CMD mode) and
+	 * drm_atomic_bridge_chain_enable (video mode).  Writing bridge regs
+	 * here — especially DSI_BRG_EN — causes the bridge to drive DPI
+	 * sync signals onto the DW host's DPI input before it has configured
+	 * CMD mode for panel DCS, blocking LP DCS commands.  Cache the timing
+	 * and do all register programming from the deferred work instead.
+	 */
+	dsi->hdisp_cache = mode->hdisplay;
+	dsi->vdisp_cache = mode->vdisplay;
+	dsi->hsw_cache   = mode->hsync_end   - mode->hsync_start;
+	dsi->hbp_cache   = mode->htotal      - mode->hsync_end;
+	dsi->hfp_cache   = mode->hsync_start - mode->hdisplay;
+	dsi->vsw_cache   = mode->vsync_end   - mode->vsync_start;
+	dsi->vbp_cache   = mode->vtotal      - mode->vsync_end;
+	dsi->vfp_cache   = mode->vsync_start - mode->vdisplay;
+
+	/*
+	 * v5: 3 s delay instead of 400 ms. The late-enable work now programs
+	 * the bridge and performs the VIDEO-mode transition — it must fire
+	 * AFTER panel_bridge.enable completes, which runs after dw_bridge.
+	 * atomic_enable (~1.25 s) plus ST7703 .enable's init table (~50 ms)
+	 * + sleep_out wait (120 ms) + DISPLAY_ON — so completion ~1.4 s.
+	 * 3 s gives ~1.5 s margin. TODO: replace with a proper bridge-chain-
+	 * done hook once bring-up settles.
+	 */
+	schedule_delayed_work(&dsi->dpi_enable_work, msecs_to_jiffies(3000));
+}
+
+static void esp32p4_dsi_pipe_disable(struct drm_simple_display_pipe *pipe)
+{
+	struct esp32p4_dsi *dsi = container_of(pipe, struct esp32p4_dsi, pipe);
+	void __iomem *b = dsi->bridge_regs;
+
+	cancel_delayed_work_sync(&dsi->dpi_enable_work);
+	cancel_delayed_work_sync(&dsi->fbdev_setup_work);
+
+	/* Stop DMA before disabling bridge so the GDMA engine doesn't keep
+	 * pushing into a dead FIFO. */
+	esp32p4_dsi_gdma_release(dsi);
+
+	/* Disable DPI pixel output first to avoid underrun storm, then bridge */
+	writel(readl(b + DSI_BRG_DPI_MISC_CFG) & ~BIT(0),
+	       b + DSI_BRG_DPI_MISC_CFG);
+	writel(BIT(0), b + DSI_BRG_DPI_CFG_UPDATE);
+	writel(0u, b + DSI_BRG_EN);
+}
+
+/*
+ * Copy a DRM framebuffer into fb_cpu, applying the 90° CCW rotation
+ * needed to cancel out the BONO panel's locked-MV-bit rotation
+ * (panel-locked MV bit). Returns true if the copy ran.
+ *
+ * Cheap enough at fbcon update rates — full transpose of 720×720
+ * RGB565 (~1 MB) takes a handful of ms. If this becomes a bottleneck,
+ * the right answer is to reprogram GDMA to walk the buffer in
+ * column-major order rather than copy-with-rotate every commit.
+ *
+ * Used in two places:
+ *   - esp32p4_dsi_pipe_update on every atomic commit
+ *   - end of esp32p4_dsi_dpi_enable_work as a one-shot catch-up for
+ *     any commits that fired before fb_cpu was allocated
+ */
+/*
+ * Tiled transpose: small enough that one source-column cache line stays
+ * hot across all 16 row-iterations of the tile, instead of the original
+ * per-pixel stride-W*2 reads that thrashed L1D. With TILE=16, a 16×16
+ * RGB565 tile is 512 B src + 512 B dst — fits comfortably in L1. 720 is
+ * an exact multiple of 16 so there is no edge case to handle.
+ *
+ * Brings the 720×720 blit from ~200 ms (limiting fbdefio to ~5 Hz) down
+ * to well under the 50 ms defio cycle.
+ */
+#define ESP32P4_BLIT_TILE 16
+
+static bool esp32p4_dsi_blit_fb(struct esp32p4_dsi *dsi,
+				struct drm_framebuffer *fb,
+				u32 src_y)
+{
+	struct drm_gem_dma_object *src_obj;
+	u16 *src, *dst;
+	u32 W, H, src_stride_px, br, bc, r, c;
+
+	if (!fb || !dsi->fb_cpu)
+		return false;
+
+	src_obj = to_drm_gem_dma_obj(drm_gem_fb_get_obj(fb, 0));
+	if (!src_obj || !src_obj->vaddr)
+		return false;
+
+	W = dsi->hdisp_cache;
+	H = dsi->vdisp_cache;
+	src_stride_px = fb->pitches[0] / 2;
+	/*
+	 * Honor plane_state->src_y. fbcon can switch into pan/wrap scroll
+	 * modes — the DRM core advances the plane's src_y on each scroll
+	 * and we must read from the offset window, otherwise the screen
+	 * shows the gem buffer at fixed [0..H-1] while fbcon writes new
+	 * lines past the visible window: the most recent line shows up
+	 * at the top of the panel and the rest "moves down by one line"
+	 * — exact symptom seen on the badge.
+	 */
+	src = (u16 *)src_obj->vaddr + src_y * src_stride_px;
+	dst = (u16 *)dsi->fb_cpu;
+
+	/*
+	 * Bridge/DPI timing on this silicon shows pixels at panel_y =
+	 * (dst_col + 16) mod H — we measured this empirically with a
+	 * corner-color test. We don't yet know which IDF init step we're
+	 * missing to remove this 16-pixel-deterministic offset; until
+	 * then, compensate at blit-time by reading the source row shifted
+	 * by +16 (i.e. "dst column C will be panel row (C+16) mod H, so
+	 * read whatever should land at panel row (C+16) mod H, which is
+	 * gem-y (C+16) mod H").
+	 *
+	 * One font row exactly. Smells like a vsync-line miscount but
+	 * could also be a bridge FIFO depth mismatch — IDF programs more
+	 * registers (raw_buf_credit, dma_block_interval, etc) we leave at
+	 * reset defaults. Worth revisiting once typing input is live.
+	 */
+#define ESP32P4_PANEL_VSHIFT 16
+	dev_info_once(dsi->dev,
+		      "blit: 90-degree CCW rotation + %d-px panel vshift workaround active "
+		      "(panel_y = (dst_col + %d) mod H); see comment above ESP32P4_PANEL_VSHIFT\n",
+		      ESP32P4_PANEL_VSHIFT, ESP32P4_PANEL_VSHIFT);
+
+	for (br = 0; br < H; br += ESP32P4_BLIT_TILE) {
+		for (bc = 0; bc < W; bc += ESP32P4_BLIT_TILE) {
+			for (r = br; r < br + ESP32P4_BLIT_TILE; r++) {
+				u16 *dst_row = dst + r * W;
+				u32 src_col_off = (W - 1 - r);
+				for (c = bc; c < bc + ESP32P4_BLIT_TILE; c++) {
+					u32 src_row = (c + ESP32P4_PANEL_VSHIFT) % H;
+					dst_row[c] = src[src_row * src_stride_px + src_col_off];
+				}
+			}
+		}
+	}
+
+	esp32p4_dsi_psram_flush(dsi->fb_cpu, dsi->fb_size);
+	return true;
+}
+
+/*
+ * Called on every atomic commit that targets this pipe (fbcon writes,
+ * userspace KMS clients, etc.). The DRM core has prepared a new
+ * drm_framebuffer in plane_state->fb backed by a CMA gem object.
+ *
+ * Early in boot this can fire before dpi_enable_work has allocated
+ * fb_cpu (gdma_arm). Those commits can't be serviced; they're caught
+ * up by the explicit blit at the end of dpi_enable_work.
+ */
+static void esp32p4_dsi_pipe_update(struct drm_simple_display_pipe *pipe,
+				    struct drm_plane_state *old_state)
+{
+	struct esp32p4_dsi *dsi = container_of(pipe, struct esp32p4_dsi, pipe);
+	struct drm_plane_state *state = pipe->plane.state;
+	static int count;
+	static u32 last_src_y = (u32)-1;
+	u32 src_y = (state && state->fb) ? (state->src_y >> 16) : 0;
+
+	if (src_y != last_src_y) {
+		dev_dbg(dsi->dev,
+			"pipe_update: src_y %u -> %u (fbcon pan/wrap %s)\n",
+			last_src_y, src_y,
+			src_y ? "active" : "cleared");
+		last_src_y = src_y;
+	}
+
+	if (!esp32p4_dsi_blit_fb(dsi, state ? state->fb : NULL, src_y)) {
+		dev_dbg(dsi->dev,
+			"pipe_update #%d: skip (fb=%p fb_cpu=%p)\n",
+			count++, state ? state->fb : NULL, dsi->fb_cpu);
+		return;
+	}
+
+	/*
+	 * Defio fires up to 20 Hz during shell activity. First three
+	 * commits prove the path is live (boot diagnostic); past that
+	 * the per-update log is just noise on the same UART we're
+	 * watching.
+	 */
+	if (count < 3) {
+		struct drm_gem_dma_object *src_obj =
+			to_drm_gem_dma_obj(drm_gem_fb_get_obj(state->fb, 0));
+		u32 *s = src_obj->vaddr;
+
+		dev_dbg(dsi->dev,
+			"pipe_update #%d: rotated %ux%u from gem@%pK; src[0..3]=%08x %08x %08x %08x\n",
+			count, dsi->hdisp_cache, dsi->vdisp_cache,
+			src_obj->vaddr, s[0], s[1], s[2], s[3]);
+	}
+	count++;
+}
+
+static const struct drm_simple_display_pipe_funcs esp32p4_pipe_funcs = {
+	.enable		= esp32p4_dsi_pipe_enable,
+	.disable	= esp32p4_dsi_pipe_disable,
+	.update		= esp32p4_dsi_pipe_update,
+	/* prepare_fb: omitted — drm_gem_plane_helper_prepare_fb called auto */
+};
+
+/* ---------- DRM device ---------------------------------------------------- */
+
+/*
+ * Gate 5c stage 1: stand up a drm_device so /sys/class/drm/card0 exists.
+ *
+ * At this stage there are no CRTCs, no encoders, and no planes. The card
+ * will register as a DRIVER_MODESET device with 0 outputs — userspace can
+ * open it, list resources, and see nothing. That's fine. Subsequent stages
+ * in 0008..0012 fill in the pipe, attach the DW-MIPI-DSI bridge, program
+ * the Espressif bridge / DW-GDMA, and wire the MODE_CFG quirk from
+ * Finding #1.
+ *
+ * Kept deliberately minimal: if this stage won't probe, there's no point
+ * wiring anything further.
+ *
+ * Reference skeleton: drivers/gpu/drm/tiny/arcpgu.c (same pattern — small
+ * DRM driver that owns a drm_device, uses drm_gem_dma for framebuffers,
+ * attaches a bridge onto a simple_display_pipe).
+ */
+
+static const struct drm_mode_config_funcs esp32p4_dsi_mode_config_funcs = {
+	/*
+	 * _with_dirty installs drm_atomic_helper_dirtyfb as the fb's
+	 * ->dirty op. drm_fbdev_dma_helper_fb_probe checks fb->funcs->dirty
+	 * to decide whether to enable deferred-IO; without this, fbcon
+	 * writes to the gem-dma vmap go untracked and pipe_update never
+	 * fires for shell output. With defio on, the fbdefio worker
+	 * (HZ/20 = 50 ms) issues a damage atomic commit on dirty pages,
+	 * which routes through the simple-pipe to esp32p4_dsi_pipe_update
+	 * → blit_fb → live screen refresh.
+	 */
+	.fb_create	= drm_gem_fb_create_with_dirty,
+	.atomic_check	= drm_atomic_helper_check,
+	.atomic_commit	= drm_atomic_helper_commit,
+};
+
+DEFINE_DRM_GEM_DMA_FOPS(esp32p4_dsi_drm_fops);
+
+static const struct drm_driver esp32p4_dsi_drm_driver = {
+	.driver_features = DRIVER_MODESET | DRIVER_GEM | DRIVER_ATOMIC,
+	.name		= "esp32p4-dsi",
+	.desc		= "Espressif ESP32-P4 MIPI-DSI",
+	.major		= 0,
+	.minor		= 1,
+	.fops		= &esp32p4_dsi_drm_fops,
+	DRM_GEM_DMA_DRIVER_OPS,
+	DRM_FBDEV_DMA_DRIVER_OPS,
+};
+
+/*
+ * BONO is 720×720. Give DRM plenty of headroom — this governs fb_create
+ * validation and the connector probe path later, not the video-timing
+ * registers.
+ */
+static int esp32p4_dsi_drm_init(struct esp32p4_dsi *dsi)
+{
+	struct drm_device *drm = &dsi->drm;
+	struct drm_bridge *bridge;
+	int ret;
+
+	ret = drmm_mode_config_init(drm);
+	if (ret)
+		return ret;
+
+	drm->mode_config.min_width  = 0;
+	drm->mode_config.min_height = 0;
+	drm->mode_config.max_width  = 2048;
+	drm->mode_config.max_height = 2048;
+	drm->mode_config.funcs      = &esp32p4_dsi_mode_config_funcs;
+
+	/*
+	 * Stand up the display pipe: one primary plane (RGB565), one CRTC,
+	 * one encoder. Pass NULL for connector — the connector comes from the
+	 * DW-MIPI-DSI bridge chain (panel bridge creates it during attach).
+	 */
+	ret = drm_simple_display_pipe_init(drm, &dsi->pipe, &esp32p4_pipe_funcs,
+					   esp32p4_dsi_formats,
+					   ARRAY_SIZE(esp32p4_dsi_formats),
+					   NULL, NULL);
+	if (ret)
+		return ret;
+
+	/*
+	 * Required by drm_gem_fb_create_with_dirty: lets the atomic damage
+	 * machinery attach FB_DAMAGE_CLIPS to plane state. Without it the
+	 * fbdefio path silently degrades to full-frame damage on every
+	 * worker tick, which still works but can't propagate clip rects.
+	 */
+	drm_plane_enable_fb_damage_clips(&dsi->pipe.plane);
+
+	/*
+	 * Attach the Synopsys DW-MIPI-DSI bridge. This triggers:
+	 *   dw_mipi_dsi_bridge_attach → drm_of_find_panel_or_bridge →
+	 *   panel_bridge_attach → st7703_get_modes (modes from panel driver).
+	 * After this call the connector is live and userspace can enumerate it.
+	 */
+	bridge = dw_mipi_dsi_get_bridge(dsi->dmd);
+	ret = drm_simple_display_pipe_attach_bridge(&dsi->pipe, bridge);
+	if (ret)
+		return ret;
+
+	drm_kms_helper_poll_init(drm);
+
+	/*
+	 * Reset all state machines to their initial values. Must happen after
+	 * all objects are registered but before drm_dev_register opens the
+	 * device to userspace.
+	 */
+	drm_mode_config_reset(drm);
+
+	return 0;
+}
+
+/* ---------- probe/remove ------------------------------------------------ */
+
+static int esp32p4_dsi_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct esp32p4_dsi *dsi;
+	int ret;
+
+	/*
+	 * devm_drm_dev_alloc replaces the devm_kzalloc we had before: it
+	 * allocates + initialises a drm_device embedded in struct
+	 * esp32p4_dsi. Freed automatically when the platform device goes
+	 * away.
+	 */
+	dsi = devm_drm_dev_alloc(dev, &esp32p4_dsi_drm_driver,
+				 struct esp32p4_dsi, drm);
+	if (IS_ERR(dsi))
+		return PTR_ERR(dsi);
+
+	dsi->dev = dev;
+	platform_set_drvdata(pdev, dsi);
+	INIT_DELAYED_WORK(&dsi->dpi_enable_work, esp32p4_dsi_dpi_enable_work);
+	INIT_DELAYED_WORK(&dsi->fbdev_setup_work, esp32p4_dsi_fbdev_setup_work);
+
+	/*
+	 * All framebuffers live in the CMA region declared as display_cma
+	 * in DT (see phase3-display.dtsi). The DW-GDMA downstream of the
+	 * Espressif bridge is a 32-bit master.
+	 */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return dev_err_probe(dev, ret, "32-bit DMA mask rejected\n");
+
+	dsi->host_regs = devm_platform_ioremap_resource_byname(pdev, "host");
+	if (IS_ERR(dsi->host_regs))
+		return dev_err_probe(dev, PTR_ERR(dsi->host_regs),
+				     "failed to map DW-MIPI-DSI host regs\n");
+
+	dsi->bridge_regs = devm_platform_ioremap_resource_byname(pdev, "bridge");
+	if (IS_ERR(dsi->bridge_regs))
+		return dev_err_probe(dev, PTR_ERR(dsi->bridge_regs),
+				     "failed to map Espressif bridge regs\n");
+
+	/*
+	 * DW-GDMA — not declared in DT (no upstream binding for it on P4).
+	 * Map directly. devm_ioremap on a fixed phys/length is fine.
+	 */
+	dsi->gdma_regs = devm_ioremap(dev, ESP32P4_GDMA_BASE, ESP32P4_GDMA_SIZE);
+	if (!dsi->gdma_regs)
+		return dev_err_probe(dev, -ENOMEM,
+				     "failed to map DW-GDMA regs\n");
+
+	dsi->phy_supply = devm_regulator_get(dev, "phy");
+	if (IS_ERR(dsi->phy_supply))
+		return dev_err_probe(dev, PTR_ERR(dsi->phy_supply),
+				     "failed to get phy-supply\n");
+
+	/*
+	 * Always-on in DT for now (LDO3 pre-enabled by boot shim); enable()
+	 * is still required so the regulator refcount is correct when a
+	 * real P4 LDO driver lands.
+	 */
+	ret = regulator_enable(dsi->phy_supply);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable phy-supply\n");
+
+	/*
+	 * Before touching any DSI host register, make sure the SoC-level
+	 * clock gates and bridge reset are in a known state. See
+	 * esp32p4_dsi_clkrst_audit() for the why.
+	 */
+	esp32p4_dsi_clkrst_audit(dev);
+
+	/*
+	 * IDF golden has DSI_BRG_CLK_EN (offset 0x000) = 0. The
+	 * mipi_dsi_brg_ll_force_enable_reg_clock() helper exists but is
+	 * never called anywhere in IDF's source tree. Earlier we forced
+	 * this to 1 with an "IDF does this" rationale that was wrong;
+	 * doing so apparently interferes with the bridge's DSI forwarding
+	 * logic on the v1.x silicon — leaving it at the reset default of
+	 * 0 (dynamically gated) is what produces working video in IDF.
+	 *
+	 * Also enable underrun interrupt (int_ena bit 0 = 1) to match IDF
+	 * golden 0x050 = 0x1. Just the interrupt enable, not the handler;
+	 * we'll see in dmesg if it ever fires.
+	 */
+	writel(0, dsi->bridge_regs + DSI_BRG_CLK_EN);
+	writel(BIT(0), dsi->bridge_regs + 0x50); /* int_ena: underrun */
+
+	/*
+	 * Turn on LDO3 (2500 mV) for the DSI PHY analog supply. Boot shim
+	 * doesn't, and without it the PHY PLL cannot lock. See
+	 * esp32p4_dsi_ldo3_enable() for the rationale.
+	 */
+	esp32p4_dsi_ldo3_enable(dev);
+
+	dsi->rst = devm_reset_control_get_optional_exclusive(dev, NULL);
+	if (IS_ERR(dsi->rst)) {
+		ret = PTR_ERR(dsi->rst);
+		goto err_regulator;
+	}
+
+	reset_control_deassert(dsi->rst);
+
+	/* Compose plat_data and hand off to the Synopsys bridge driver. */
+	dsi->pdata.base = dsi->host_regs;
+	dsi->pdata.max_data_lanes = ESP32P4_DSI_MAX_LANES;
+	dsi->pdata.phy_ops = &esp32p4_dsi_phy_ops;
+	dsi->pdata.host_ops = &esp32p4_dsi_host_ops;
+	dsi->pdata.priv_data = dsi;
+	/*
+	 * v5: skip the DW core's set_mode(VIDEO) in atomic_enable. Panel init
+	 * DCS must run in CMD mode (IDF-style), so dpi_enable_work performs
+	 * the VIDEO transition later via dw_mipi_dsi_late_enable_video().
+	 */
+	dsi->pdata.defer_video_mode_switch = true;
+
+	dsi->dmd = dw_mipi_dsi_probe(pdev, &dsi->pdata);
+	if (IS_ERR(dsi->dmd)) {
+		ret = dev_err_probe(dev, PTR_ERR(dsi->dmd),
+				    "dw_mipi_dsi_probe failed\n");
+		goto err_reset;
+	}
+
+	/*
+	 * mipi_dsi_host_register (called inside dw_mipi_dsi_probe) creates
+	 * the panel mipi_dsi_device from DT. If the panel driver is registered
+	 * AND all its dependencies are ready, its probe runs synchronously,
+	 * calls mipi_dsi_attach(), which calls our host_attach callback, which
+	 * sets dsi->host_attached = true. drm_init then has dsi->panel_bridge
+	 * available via dw_mipi_dsi's internal state.
+	 *
+	 * If the panel probe defers (e.g., a regulator/gpio dep not yet ready),
+	 * host_attached stays false. drm_init's bridge attach would then fail
+	 * with -EINVAL because dsi->panel_bridge is NULL. Defer our own probe
+	 * so the kernel retries us after all panel deps come up.
+	 */
+	if (!dsi->host_attached) {
+		dev_dbg(dev, "panel mipi_dsi_attach not yet called; deferring probe\n");
+		dw_mipi_dsi_remove(dsi->dmd);
+		ret = -EPROBE_DEFER;
+		goto err_reset;
+	}
+
+	/*
+	 * Gate 5c stage 1: init mode_config and register the drm_device so
+	 * userspace sees /sys/class/drm/card0. No CRTCs/encoders/planes yet;
+	 * those land in 0008..0012.
+	 */
+	ret = esp32p4_dsi_drm_init(dsi);
+	if (ret) {
+		dev_err_probe(dev, ret, "drm mode_config init failed\n");
+		goto err_dw_dsi;
+	}
+
+	ret = drm_dev_register(&dsi->drm, 0);
+	if (ret) {
+		dev_err_probe(dev, ret, "drm_dev_register failed\n");
+		goto err_dw_dsi;
+	}
+
+	/*
+	 * Trigger DRM client setup (fbdev_probe callback). Without this,
+	 * 6.18's new client framework never invokes drm_fbdev_dma_driver_fbdev_probe
+	 * and /dev/fb0 is never created — the panel comes up electrically
+	 * but fbcon never attaches.
+	 *
+	 * Deferred to give the buddy heap time to settle past sensor probes
+	 * (BMI270 firmware upload over bit-banged I²C is the worst offender,
+	 * fragmenting memory enough that the 1 MB shadow vzalloc fails).
+	 */
+	schedule_delayed_work(&dsi->fbdev_setup_work, 3 * HZ);
+
+	/*
+	 * Start fbdev emulation so the kernel issues an initial atomic
+	 * mode-set without needing a userspace compositor. This is what
+	 * fires pipe_enable for the first time (→ DPI_OUTPUT_EN → HS
+	 * traffic → C6 turns on the backlight). Bpp=16 matches RGB565.
+	 *
+	 * Linux 6.18: fbdev probe is now wired via the drm_driver
+	 * .fbdev_probe callback (DRM_FBDEV_DMA_DRIVER_OPS macro), so
+	 * drm_fbdev_dma_setup() is no longer called explicitly.
+	 */
+
+	dev_info(dev,
+		 "esp32p4-mipi-dsi: registered (%u lanes @ %u Mbps)\n",
+		 ESP32P4_DSI_MAX_LANES, ESP32P4_DSI_LANE_MBPS);
+	return 0;
+
+err_dw_dsi:
+	dw_mipi_dsi_remove(dsi->dmd);
+err_reset:
+	reset_control_assert(dsi->rst);
+err_regulator:
+	regulator_disable(dsi->phy_supply);
+	return ret;
+}
+
+static void esp32p4_dsi_remove(struct platform_device *pdev)
+{
+	struct esp32p4_dsi *dsi = platform_get_drvdata(pdev);
+
+	drm_dev_unregister(&dsi->drm);
+	drm_kms_helper_poll_fini(&dsi->drm);
+	dw_mipi_dsi_remove(dsi->dmd);
+	reset_control_assert(dsi->rst);
+	regulator_disable(dsi->phy_supply);
+}
+
+static const struct of_device_id esp32p4_dsi_of_match[] = {
+	{ .compatible = "espressif,esp32p4-mipi-dsi" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, esp32p4_dsi_of_match);
+
+static struct platform_driver esp32p4_dsi_driver = {
+	.probe	= esp32p4_dsi_probe,
+	.remove	= esp32p4_dsi_remove,
+	.driver	= {
+		.name		= "esp32p4-mipi-dsi",
+		.of_match_table	= esp32p4_dsi_of_match,
+	},
+};
+module_platform_driver(esp32p4_dsi_driver);
+
+MODULE_AUTHOR("WHY2025 Linux port");
+MODULE_DESCRIPTION("Espressif ESP32-P4 MIPI-DSI glue (DW-MIPI-DSI wrapper)");
+MODULE_LICENSE("GPL");
