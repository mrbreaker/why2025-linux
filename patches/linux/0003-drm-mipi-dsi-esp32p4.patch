+static int esp32p4_dsi_phy_get_lane_mbps(void *priv_data,
+					 const struct drm_display_mode *mode,
+					 unsigned long mode_flags, u32 lanes,
+					 u32 format, unsigned int *lane_mbps)
+{
+	struct esp32p4_dsi *dsi = priv_data;
+
+	/*
+	 * BONO panel wants 1 Gbps per lane. We ignore mode/format here —
+	 * the PHY PLL is configured by the boot shim and not retargeted at
+	 * runtime. A future gate will compute this from mode + format.
+	 */
+	*lane_mbps = ESP32P4_DSI_LANE_MBPS;
+	dev_dbg(dsi->dev, "get_lane_mbps: lanes=%u fmt=%u -> %u Mbps (fixed)\n",
+		lanes, format, *lane_mbps);
+	return 0;
+}
+
+/*
+ * D-PHY HS/LP switch timings in units of lane byte clock cycles. The DW
+ * driver treats these as device-specific but is tolerant of conservative
+ * values; these match what ST's STM32 glue uses for mid-range lane rates
+ * and are within the DW IP's programmable range. Real values need to
+ * come out of the ESP32-P4 PHY datasheet (@TODO).
+ */
+static int esp32p4_dsi_phy_get_timing(void *priv_data, unsigned int lane_mbps,
+				      struct dw_mipi_dsi_dphy_timing *timing)
+{
+	/*
+	 * D-PHY HS/LP switch timings in lanebyteclk cycles.
+	 *
+	 * Values copied from IDF's esp_lcd_mipi_dsi_bus.c:
+	 *   mipi_dsi_phy_ll_set_switch_time(hal->host, 50, 104, 46, 128);
+	 *                                             data_hs2lp=50
+	 *                                             data_lp2hs=104
+	 *                                             clk_hs2lp=46
+	 *                                             clk_lp2hs=128
+	 *
+	 * Previous values (all 0x40 = 64) were STM32 glue placeholders. On
+	 * the ESP32-P4 D-PHY with our PLL config (2000 MHz VCO, 1 Gbps lane,
+	 * 125 MHz byteclk) the placeholders yielded data_lp2hs too short (64
+	 * vs 104) and clk_lp2hs half what's needed (64 vs 128). Symptom: DW
+	 * host reports HS on data lanes, but the panel never sees a valid
+	 * LP->HS sync — every packet decoded as garbage, panel stays in
+	 * default power-on state with no visible output even under external
+	 * transmissive lighting.
+	 */
+	timing->data_hs2lp = 50;
+	timing->data_lp2hs = 104;
+	timing->clk_hs2lp  = 46;
+	timing->clk_lp2hs  = 128;
+	return 0;
+}
