+	/*
+	 * SDMMC_CMD register has a 5-bit card_number field at bits [20:16]
+	 * that selects which physical slot the command targets. Mainline
+	 * dw_mmc was multi-slot historically but the loop was removed and
+	 * slot->id is hardcoded to 0; we read it from DT (`snps,slot-id`)
+	 * to restore support for boards that wire their card on a non-zero
+	 * physical slot. (The WHY2025 badge's own microSD is on slot 0.)
+	 */
+	cmd |= slot->id << 16;
+
 	mci_writel(host, CMDARG, arg);
 	wmb(); /* drain writebuffer */
 	dw_mci_wait_while_busy(host, cmd);
@@ -314,6 +324,9 @@
 	if (!test_bit(DW_MMC_CARD_NO_USE_HOLD, &slot->flags))
 		cmdr |= SDMMC_CMD_USE_HOLD_REG;
 
+	/* CMD.card_number = slot->id; see comment in mci_send_cmd. */
+	cmdr |= slot->id << 16;
+
 	return cmdr;
 }
 
@@ -353,6 +366,9 @@
 	if (!test_bit(DW_MMC_CARD_NO_USE_HOLD, &host->slot->flags))
 		cmdr |= SDMMC_CMD_USE_HOLD_REG;
 
+	/* CMD.card_number = slot->id; see comment in mci_send_cmd. */
+	cmdr |= host->slot->id << 16;
