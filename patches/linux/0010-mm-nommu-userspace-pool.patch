+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Reserved-memory pool for large NOMMU user-space mmap allocations.
+ *
+ * See Documentation/devicetree/bindings/reserved-memory/
+ * linux,nommu-userspace-pool.yaml for the binding and the rationale.
+ */
+#ifndef _LINUX_NOMMU_USERSPACE_POOL_H
+#define _LINUX_NOMMU_USERSPACE_POOL_H
+
+#include <linux/types.h>
+
+#ifdef CONFIG_NOMMU_USERSPACE_POOL
+
+/*
+ * Try to allocate a contiguous range of @size bytes (page-aligned by the
+ * caller) from the configured reserved pool. Returns a kernel-virtual
+ * pointer on success, NULL if the pool is unavailable or out of space.
+ */
+void *nommu_userspace_pool_alloc(size_t size);
+
+/*
+ * Free a region previously returned by nommu_userspace_pool_alloc().
+ * @addr must be the exact pointer returned, @size the exact size passed.
+ */
+void nommu_userspace_pool_free(void *addr, size_t size);
+
+#else /* !CONFIG_NOMMU_USERSPACE_POOL */
+
+static inline void *nommu_userspace_pool_alloc(size_t size)
+{
+	return NULL;
+}
+
+static inline void nommu_userspace_pool_free(void *addr, size_t size)
+{
+}
+
+#endif /* CONFIG_NOMMU_USERSPACE_POOL */
+
+#endif /* _LINUX_NOMMU_USERSPACE_POOL_H */
