--- /dev/null	2026-05-03 14:38:22.219445125 +0200
+++ b/mm/nommu_userspace_pool.c	2026-05-05 11:14:25.134066532 +0200
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Reserved-memory pool for large NOMMU user-space mmap allocations.
+ *
+ * On NOMMU, every private mmap (fork+exec, anonymous malloc, brk-grown
+ * heap) is satisfied by ONE physically contiguous page range. The
+ * buddy allocator fragments quickly on small (tens of MB) NOMMU
+ * machines, leaving plenty of nominal free memory but no free blocks
+ * of the order a non-trivial fork+exec needs. CONFIG_CMA — the
+ * standard answer — depends on MMU.
+ *
+ * This file implements a small generic mechanism: a DT-described
+ * reserved range, served by a gen_pool, that the NOMMU mmap path
+ * draws from before falling back to alloc_pages_exact(). See
+ * Documentation/devicetree/bindings/reserved-memory/
+ * linux,nommu-userspace-pool.yaml for the binding.
+ */
+
+#define pr_fmt(fmt) "nommu_userspace_pool: " fmt
+
+#include <linux/genalloc.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/mm.h>
+#include <linux/nommu_userspace_pool.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/printk.h>
+#include <linux/sizes.h>
+
+static struct gen_pool *user_pool;
+
+/*
+ * Captured at early-boot RESERVEDMEM_OF_DECLARE time and consumed by
+ * the core_initcall that actually builds the gen_pool — gen_pool_create
+ * needs the slab allocator, which is not yet available when reserved
+ * memory regions are first parsed.
+ */
+static phys_addr_t pool_phys __initdata;
+static size_t pool_size __initdata;
+
+void *nommu_userspace_pool_alloc(size_t size)
+{
+	unsigned long va;
+
+	if (!user_pool || !size)
+		return NULL;
+
+	va = gen_pool_alloc(user_pool, size);
+	return (void *)va; /* 0 → NULL on failure, which is what we want */
+}
+
+void nommu_userspace_pool_free(void *addr, size_t size)
+{
+	if (!user_pool || !addr)
+		return;
+	gen_pool_free(user_pool, (unsigned long)addr, size);
+}
+
+static int __init nommu_userspace_pool_init(void)
+{
+	void *va;
+	int ret;
+
+	if (!pool_size)
+		return 0;
+
+	user_pool = gen_pool_create(PAGE_SHIFT, NUMA_NO_NODE);
+	if (!user_pool) {
+		pr_err("gen_pool_create failed\n");
+		return -ENOMEM;
+	}
+
+	/*
+	 * Reserved-memory regions registered via RESERVEDMEM_OF_DECLARE
+	 * are excluded from the buddy allocator (memblock_reserve) but
+	 * remain part of the kernel direct map and have struct pages.
+	 * phys_to_virt is therefore the right address translation here;
+	 * no ioremap is needed and the memory is cached, matching how
+	 * userspace expects to see its text/data.
+	 */
+	va = phys_to_virt(pool_phys);
+
+	ret = gen_pool_add_virt(user_pool, (unsigned long)va, pool_phys,
+				pool_size, NUMA_NO_NODE);
+	if (ret) {
+		pr_err("gen_pool_add_virt failed: %d\n", ret);
+		gen_pool_destroy(user_pool);
+		user_pool = NULL;
+		return ret;
+	}
+
+	pr_info("%zu KiB at %pa serves NOMMU user mmap allocations\n",
+		pool_size / SZ_1K, &pool_phys);
+	return 0;
+}
+core_initcall(nommu_userspace_pool_init);
+
+static int __init nommu_userspace_pool_rmem(struct reserved_mem *rmem)
+{
+	if (pool_size) {
+		pr_warn("multiple pool regions declared; ignoring %pa\n",
+			&rmem->base);
+		return -EINVAL;
+	}
+
+	pool_phys = rmem->base;
+	pool_size = rmem->size;
+	pr_info("reserved %zu KiB at %pa for user mmap allocations\n",
+		pool_size / SZ_1K, &pool_phys);
+	return 0;
+}
+RESERVEDMEM_OF_DECLARE(nommu_userspace_pool, "linux,nommu-userspace-pool",
+		       nommu_userspace_pool_rmem);
