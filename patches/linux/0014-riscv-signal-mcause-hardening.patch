 		/* Avoid additional syscall restarting via ret_from_exception */
+#ifdef CONFIG_SOC_ESP32P4
+		/*
+		 * Same MINHV/INT footgun as rt_sigreturn above: the CLIC v0.9
+		 * exit shim in entry.S writes pt_regs->cause back into mcause
+		 * before mret, and -1UL survives the shim mask as INT=1 plus
+		 * a reserved exccode -- an encoding this core has wedged on
+		 * before (invisible trap-refetch loop, timer IRQs blocked).
+		 *
+		 * This path is hot: it runs for every pending signal taken
+		 * during a syscall, including the default-ignored SIGCHLD
+		 * queued at each child exit -- i.e. once per iteration of any
+		 * fork+exec loop. Use 0, which makes the EXC_SYSCALL compare
+		 * false just as well.
+		 */
+		regs->cause = 0;
+#else
 		regs->cause = -1UL;
+#endif
 
