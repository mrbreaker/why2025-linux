--- /dev/null
+++ b/drivers/watchdog/esp32p4_wdt.c
@@ -0,0 +1,225 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ESP32-P4 Timer Group main watchdog (MWDT0) driver.
+ *
+ * The WHY2025 badge's silent-wedge investigation needs a dead-man's
+ * switch that survives total scheduler death (docs/RUNTIME-WEDGE.md):
+ * this drives TIMG0's MWDT with stage 0 = system reset. The hardware is
+ * started at probe and flagged WDOG_HW_RUNNING, so the watchdog core
+ * keeps it fed from a kernel worker until userspace opens
+ * /dev/watchdog -- a wedge that kills the scheduler stops the feeds and
+ * the chip hard-resets into the boot shim within the timeout. The
+ * driver also registers as the machine restart handler; without it this
+ * M-mode NOMMU kernel has no reboot path at all.
+ *
+ * Register facts from ESP-IDF v5.5.3 (components/soc/esp32p4/register/
+ * hw_ver1/soc/timer_group_reg.h and components/hal/esp32p4/include/hal/
+ * mwdt_ll.h): the MWDT clock source is fixed at the 40 MHz XTAL and the
+ * module clock defaults to enabled on this SoC, so no clock-controller
+ * handle is needed. Config registers latch only after strobing
+ * CONF_UPDATE_EN, and every WDT register sits behind the 0x50d83aa1
+ * write-protect key.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/watchdog.h>
+
+#define TIMG_WDTCONFIG0			0x48
+#define  TIMG_WDT_EN			BIT(31)
+#define  TIMG_WDT_STG0			GENMASK(30, 29)
+#define  TIMG_WDT_CONF_UPDATE_EN	BIT(22)
+#define  TIMG_WDT_CPU_RESET_LENGTH	GENMASK(20, 18)
+#define  TIMG_WDT_SYS_RESET_LENGTH	GENMASK(17, 15)
+#define  TIMG_WDT_FLASHBOOT_MOD_EN	BIT(14)
+#define TIMG_WDTCONFIG1			0x4c
+#define  TIMG_WDT_CLK_PRESCALE		GENMASK(31, 16)
+#define TIMG_WDTCONFIG2			0x50
+#define TIMG_WDTFEED			0x60
+#define TIMG_WDTWPROTECT		0x64
+
+#define TIMG_WDT_STG_SEL_RESET_SYSTEM	3
+#define TIMG_WDT_RESET_LENGTH_3200_NS	7
+#define TIMG_WDT_WKEY_UNLOCK		0x50d83aa1
+
+/* 40 MHz XTAL / 40000 -> 1 kHz WDT tick, i.e. 1 ms per stage-hold unit. */
+#define ESP32P4_WDT_PRESCALE		40000
+#define ESP32P4_WDT_TICK_HZ		1000
+
+#define ESP32P4_WDT_DEFAULT_TIMEOUT_S	30
+#define ESP32P4_WDT_MAX_TIMEOUT_S	3600
+
+struct esp32p4_wdt {
+	struct watchdog_device wdd;
+	void __iomem *base;
+};
+
+static void esp32p4_wdt_unlock(struct esp32p4_wdt *wdt)
+{
+	writel(TIMG_WDT_WKEY_UNLOCK, wdt->base + TIMG_WDTWPROTECT);
+}
+
+static void esp32p4_wdt_relock(struct esp32p4_wdt *wdt)
+{
+	writel(0, wdt->base + TIMG_WDTWPROTECT);
+}
+
+/* Arm stage 0 for a system reset after @timeout_ticks (1 ms units). */
+static void esp32p4_wdt_arm(struct esp32p4_wdt *wdt, u32 timeout_ticks)
+{
+	u32 conf = TIMG_WDT_EN |
+		   FIELD_PREP(TIMG_WDT_STG0, TIMG_WDT_STG_SEL_RESET_SYSTEM) |
+		   FIELD_PREP(TIMG_WDT_SYS_RESET_LENGTH,
+			      TIMG_WDT_RESET_LENGTH_3200_NS) |
+		   FIELD_PREP(TIMG_WDT_CPU_RESET_LENGTH,
+			      TIMG_WDT_RESET_LENGTH_3200_NS);
+
+	esp32p4_wdt_unlock(wdt);
+	writel(FIELD_PREP(TIMG_WDT_CLK_PRESCALE, ESP32P4_WDT_PRESCALE),
+	       wdt->base + TIMG_WDTCONFIG1);
+	writel(timeout_ticks, wdt->base + TIMG_WDTCONFIG2);
+	/* Stages 1-3 stay OFF: stage 0 alone resets the system. */
+	writel(conf, wdt->base + TIMG_WDTCONFIG0);
+	writel(conf | TIMG_WDT_CONF_UPDATE_EN, wdt->base + TIMG_WDTCONFIG0);
+	writel(1, wdt->base + TIMG_WDTFEED);
+	esp32p4_wdt_relock(wdt);
+}
+
+static int esp32p4_wdt_start(struct watchdog_device *wdd)
+{
+	struct esp32p4_wdt *wdt = watchdog_get_drvdata(wdd);
+
+	esp32p4_wdt_arm(wdt, wdd->timeout * ESP32P4_WDT_TICK_HZ);
+
+	return 0;
+}
+
+static int esp32p4_wdt_stop(struct watchdog_device *wdd)
+{
+	struct esp32p4_wdt *wdt = watchdog_get_drvdata(wdd);
+
+	esp32p4_wdt_unlock(wdt);
+	writel(0, wdt->base + TIMG_WDTCONFIG0);
+	writel(TIMG_WDT_CONF_UPDATE_EN, wdt->base + TIMG_WDTCONFIG0);
+	esp32p4_wdt_relock(wdt);
+
+	return 0;
+}
+
+static int esp32p4_wdt_ping(struct watchdog_device *wdd)
+{
+	struct esp32p4_wdt *wdt = watchdog_get_drvdata(wdd);
+
+	esp32p4_wdt_unlock(wdt);
+	writel(1, wdt->base + TIMG_WDTFEED);
+	esp32p4_wdt_relock(wdt);
+
+	return 0;
+}
+
+static int esp32p4_wdt_set_timeout(struct watchdog_device *wdd,
+				   unsigned int timeout)
+{
+	wdd->timeout = timeout;
+
+	return esp32p4_wdt_start(wdd);
+}
+
+static int esp32p4_wdt_restart(struct watchdog_device *wdd,
+			       unsigned long action, void *data)
+{
+	struct esp32p4_wdt *wdt = watchdog_get_drvdata(wdd);
+
+	esp32p4_wdt_arm(wdt, 1);	/* fire in 1 ms */
+	mdelay(100);			/* reset happens under us */
+
+	return 0;
+}
+
+static const struct watchdog_info esp32p4_wdt_info = {
+	.options = WDIOF_SETTIMEOUT | WDIOF_KEEPALIVEPING | WDIOF_MAGICCLOSE,
+	.identity = "ESP32-P4 MWDT",
+};
+
+static const struct watchdog_ops esp32p4_wdt_ops = {
+	.owner = THIS_MODULE,
+	.start = esp32p4_wdt_start,
+	.stop = esp32p4_wdt_stop,
+	.ping = esp32p4_wdt_ping,
+	.set_timeout = esp32p4_wdt_set_timeout,
+	.restart = esp32p4_wdt_restart,
+};
+
+static int esp32p4_wdt_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct esp32p4_wdt *wdt;
+	u32 val;
+
+	wdt = devm_kzalloc(dev, sizeof(*wdt), GFP_KERNEL);
+	if (!wdt)
+		return -ENOMEM;
+
+	wdt->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(wdt->base))
+		return PTR_ERR(wdt->base);
+
+	wdt->wdd.info = &esp32p4_wdt_info;
+	wdt->wdd.ops = &esp32p4_wdt_ops;
+	wdt->wdd.min_timeout = 1;
+	wdt->wdd.max_timeout = ESP32P4_WDT_MAX_TIMEOUT_S;
+	wdt->wdd.timeout = ESP32P4_WDT_DEFAULT_TIMEOUT_S;
+	wdt->wdd.parent = dev;
+	watchdog_set_drvdata(&wdt->wdd, wdt);
+	watchdog_init_timeout(&wdt->wdd, 0, dev);
+	watchdog_set_restart_priority(&wdt->wdd, 128);
+
+	/*
+	 * Flashboot WDT mode can fire even with WDT_EN=0. ESP-IDF app
+	 * startup normally clears it before the boot shim hands over,
+	 * but clear it explicitly rather than depending on that.
+	 */
+	esp32p4_wdt_unlock(wdt);
+	val = readl(wdt->base + TIMG_WDTCONFIG0);
+	writel((val & ~TIMG_WDT_FLASHBOOT_MOD_EN) | TIMG_WDT_CONF_UPDATE_EN,
+	       wdt->base + TIMG_WDTCONFIG0);
+	esp32p4_wdt_relock(wdt);
+
+	/*
+	 * Start the hardware now and report it running: the watchdog
+	 * core then keeps it fed from a kernel worker until userspace
+	 * opens /dev/watchdog. That worker dies with the scheduler,
+	 * which is exactly the dead-man's-switch semantics the
+	 * silent-wedge hunt needs -- including boot-time freezes that
+	 * happen before userspace ever runs.
+	 */
+	esp32p4_wdt_arm(wdt, wdt->wdd.timeout * ESP32P4_WDT_TICK_HZ);
+	set_bit(WDOG_HW_RUNNING, &wdt->wdd.status);
+
+	return devm_watchdog_register_device(dev, &wdt->wdd);
+}
+
+static const struct of_device_id esp32p4_wdt_of_match[] = {
+	{ .compatible = "espressif,esp32p4-wdt" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, esp32p4_wdt_of_match);
+
+static struct platform_driver esp32p4_wdt_driver = {
+	.probe = esp32p4_wdt_probe,
+	.driver = {
+		.name = "esp32p4-wdt",
+		.of_match_table = esp32p4_wdt_of_match,
+	},
+};
+module_platform_driver(esp32p4_wdt_driver);
+
+MODULE_AUTHOR("WHY2025 Linux port");
+MODULE_DESCRIPTION("ESP32-P4 Timer Group watchdog");
+MODULE_LICENSE("GPL");
--- a/drivers/watchdog/Kconfig
+++ b/drivers/watchdog/Kconfig
@@ -2132,6 +2132,21 @@
 
 # RISC-V Architecture
 
+config ESP32P4_WDT
+	tristate "Espressif ESP32-P4 Timer Group watchdog"
+	depends on SOC_ESP32P4 || COMPILE_TEST
+	select WATCHDOG_CORE
+	default SOC_ESP32P4
+	help
+	  Say Y here to support the main watchdog (MWDT) in the ESP32-P4's
+	  timer groups. Stage 0 is configured for a full system reset, and
+	  the driver doubles as the machine restart handler. The hardware
+	  is started at probe time so the watchdog core's built-in worker
+	  covers the window before userspace opens /dev/watchdog.
+
+	  To compile this driver as a module, choose M here. The module
+	  will be called esp32p4_wdt.
+
 config STARFIVE_WATCHDOG
 	tristate "StarFive Watchdog support"
 	depends on ARCH_STARFIVE || COMPILE_TEST
--- a/drivers/watchdog/Makefile
+++ b/drivers/watchdog/Makefile
@@ -200,6 +200,7 @@
 obj-$(CONFIG_WATCHDOG_RTAS) += wdrtas.o
 
 # RISC-V Architecture
+obj-$(CONFIG_ESP32P4_WDT) += esp32p4_wdt.o
 obj-$(CONFIG_STARFIVE_WATCHDOG) += starfive-wdt.o
 
