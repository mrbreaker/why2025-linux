--- a/arch/riscv/boot/dts/espressif/esp32p4-why2025.dts
+++ b/arch/riscv/boot/dts/espressif/esp32p4-why2025.dts
@@ -128,6 +128,21 @@
 			clocks = <&xtal_clk>;
 			status = "okay";
 		};
+
+		/*
+		 * TIMG0 main watchdog (MWDT0), stage 0 = system reset.
+		 * Dead-man's switch for the silent-wedge investigation and
+		 * the machine restart handler (there is no other reboot
+		 * path on this SoC). Clocked from the 40 MHz XTAL with a
+		 * fixed in-driver prescaler; the MWDT module clock defaults
+		 * to enabled on P4 (ESP-IDF hal/esp32p4/mwdt_ll.h), so no
+		 * clocks handle is needed.
+		 */
+		wdt0: watchdog@500c2000 {
+			compatible = "espressif,esp32p4-wdt";
+			reg = <0x500c2000 0x100>;
+			timeout-sec = <30>;
+		};
 	};
 };
 / {
@@ -175,6 +190,36 @@
 			compatible = "linux,nommu-userspace-pool";
 			reg = <0x49600000 0x00a00000>;
 		};
+
+		/*
+		 * pstore/ramoops carveout: 128 KB just below app_pool,
+		 * taken from the kernel's own RAM (not from the pool --
+		 * that headroom belongs to the fork+exec investigation).
+		 *
+		 * Premise (unverified on this board): PSRAM contents
+		 * survive an MWDT system reset -- the DRAM keeps charge
+		 * across the short ROM+bootloader window, and the boot
+		 * shim never writes this region (kernel Image + DTB live
+		 * below 0x48810000; the rootfs prewalk only reads). With
+		 * CONFIG_PSTORE_CONSOLE=y the tail of the pre-wedge
+		 * console log survives a watchdog reset; after reboot:
+		 *   mount -t pstore pstore /sys/fs/pstore
+		 * ecc-size=16 turns on Reed-Solomon so decayed bits are
+		 * detected/corrected rather than trusted blindly. If the
+		 * persistence premise fails, ramoops just reports invalid
+		 * records -- no functional cost beyond the 128 KB.
+		 *
+		 * Layout: 4 dump records x 8 KB + 96 KB console ring.
+		 */
+		ramoops@495e0000 {
+			compatible = "ramoops";
+			reg = <0x495e0000 0x20000>;
+			record-size = <0x2000>;
+			console-size = <0x18000>;
+			pmsg-size = <0x0>;
+			ftrace-size = <0x0>;
+			ecc-size = <16>;
+		};
 	};
 
