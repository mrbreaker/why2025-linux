riscv: esp32p4: drain pending CLIC interrupts before mret to userspace

The silent-wedge campaign (docs/RUNTIME-WEDGE.md, patches 0025-0027)
established that the ESP32-P4's CLIC v0.9 core latches its internal
running level when an interrupt is accepted across an mret returning
to userspace: the final delivered interrupt carries mcause.mpil equal
to the raced handler's own level (0xFF, then 0x7F after the 0027
level partition) with a userspace EPC, and afterwards no interrupt is
accepted at any level. Kernel-return mrets never show this signature.

So stop giving the hardware the chance: in ret_from_exception's
user-return path, before the CSR_SCRATCH re-arm, scan the CLIC slot
words for a pending+enabled interrupt and, if found, take it from
kernel context - first popping the still-raised running level with an
mret onto the next instruction (a plain MIE window cannot accept an
equal-level interrupt while mil is still the returning handler's
level), then opening a short MIE window. Rescan until clear, bounded
at 8 rounds so an interrupt storm degrades to the old behaviour.

This shrinks the fatal race window from "an interrupt is pending
anywhere before the mret" (10 ms tick period worst case) to "an
interrupt arrives inside the ~50-instruction restore tail". It is
also the discriminating experiment for the raced-mret model: if the
wedge rate does not drop by orders of magnitude under the
`(while :; do :; done) &` + heartbeat reproducer, the model needs
revising. Costs 16 MMIO reads per return to userspace when nothing
is pending.

--- a/arch/riscv/kernel/entry.S
+++ b/arch/riscv/kernel/entry.S
@@ -311,6 +311,68 @@
 #endif
 #endif
 	bnez s0, 1f
+
+#ifdef CONFIG_SOC_ESP32P4
+	/*
+	 * Wedge mitigation: never mret to userspace with a CLIC interrupt
+	 * already pending. The CLIC latches its core-internal running
+	 * level when an interrupt is accepted across an mret that returns
+	 * to userspace (see docs/RUNTIME-WEDGE.md — the mpil=0xFF / 0x7F
+	 * captures), after which no interrupt is ever delivered again.
+	 * Interrupts accepted across an mret that stays in kernel never
+	 * latch (every wedge capture has a userspace EPC), so take any
+	 * pending interrupt from kernel context here instead, shrinking
+	 * the fatal window from "pending at any point before mret" to
+	 * "arrives inside the ~50-instruction restore tail below".
+	 *
+	 * This must run before the CSR_SCRATCH re-arm below: scratch is
+	 * still 0 here, so an interrupt taken inside this loop enters
+	 * handle_exception as a kernel trap on the current stack.
+	 *
+	 * Two-step drain, because when this path runs on return from an
+	 * interrupt handler the CLIC running level (mintstatus.mil) is
+	 * still that handler's level (0x7F after the level partition) and
+	 * a plain MIE window could not accept an equal-level interrupt:
+	 *   1. pop the running level with an mret to the next line
+	 *      (mcause: INT=1, MPP=M, MPIE=0, mpil=0 — MIE stays off);
+	 *   2. open a brief MIE window to accept the pending interrupt
+	 *      from a controlled, kernel-context point.
+	 * Rescan after every window; bail after 8 rounds so an interrupt
+	 * storm degrades to the old behaviour instead of looping here.
+	 */
+	li	t3, 8			/* max drain rounds */
+.Lesp32p4_drain_scan:
+	li	t0, 0x20801040		/* CLIC slot 16 ctrl word (INTIP |
+					 * INTIE<<8 | INTATTR<<16 |
+					 * INTCTL<<24); slots 16-31 cover
+					 * every peripheral the DT routes */
+	li	t2, 0x20801080		/* one past slot 31 */
+	li	t4, 0x101		/* INTIP | INTIE */
+.Lesp32p4_drain_next:
+	lw	t1, 0(t0)
+	and	t1, t1, t4
+	beq	t1, t4, .Lesp32p4_drain_take
+	addi	t0, t0, 4
+	bltu	t0, t2, .Lesp32p4_drain_next
+	j	.Lesp32p4_drain_done	/* nothing pending+enabled */
+.Lesp32p4_drain_take:
+	addi	t3, t3, -1
+	bltz	t3, .Lesp32p4_drain_done
+	la	t0, .Lesp32p4_drain_popped
+	csrw	CSR_EPC, t0
+	li	t0, 0xB0000000		/* INT=1 | MPP=M | MPIE=0 | mpil=0 */
+	csrw	CSR_CAUSE, t0
+	mret				/* pop mil -> 0, fall through */
+.Lesp32p4_drain_popped:
+	csrsi	CSR_STATUS, SR_IE	/* accept the pending interrupt */
+	nop
+	nop
+	nop
+	nop
+	csrci	CSR_STATUS, SR_IE
+	j	.Lesp32p4_drain_scan
+.Lesp32p4_drain_done:
+#endif
 
 #ifdef CONFIG_KSTACK_ERASE
 	call	stackleak_erase_on_task_stack
