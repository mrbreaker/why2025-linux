 	esp_deinit_bt(adapter);
 
 	if (adapter->if_rx_workqueue) {
@@ -1081,6 +1118,8 @@
 
 	INIT_WORK(&adapter.mac_flter_work, update_mac_filter);
 
+	INIT_DELAYED_WORK(&adapter.bt_init_work, esp_bt_init_work);
+
 	return &adapter;
 }
 
