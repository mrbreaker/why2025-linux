+/*
+ * Runs the default commit-tail, then arms the DPI/VIDEO enable work for
+ * any CRTC that just went through an enabling modeset. By the time
+ * drm_atomic_helper_commit_tail() returns, commit_modeset_enables() has
+ * run the whole bridge chain synchronously (PHY init, ST7703 reset +
+ * init table + sleep-out + DISPLAY_ON, DW host enable) — exactly the
+ * ordering pipe_enable's old fixed 3 s timer approximated, minus the
+ * dead time.
+ */
+static void esp32p4_dsi_atomic_commit_tail(struct drm_atomic_state *state)
+{
+	struct esp32p4_dsi *dsi = drm_to_esp32p4_dsi(state->dev);
+	struct drm_crtc_state *new_crtc_state;
+	struct drm_crtc *crtc;
+	unsigned int i;
+
+	drm_atomic_helper_commit_tail(state);
+
+	for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
+		if (new_crtc_state->active &&
+		    drm_atomic_crtc_needs_modeset(new_crtc_state))
+			schedule_delayed_work(&dsi->dpi_enable_work, 0);
+	}
+}
+
+static const struct drm_mode_config_helper_funcs esp32p4_dsi_mode_config_helpers = {
+	.atomic_commit_tail = esp32p4_dsi_atomic_commit_tail,
 };
 
